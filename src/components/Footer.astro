---
import { projects, projectUrl } from '../data/projects';

interface Props {
  lang: 'en' | 'ru';
}
const { lang } = Astro.props;
const home = lang === 'en' ? '/' : '/ru';
const labels = lang === 'en'
  ? { about: 'About', contact: 'Contact', press: 'Press', privacy: 'Privacy', terms: 'Terms', cookies: 'Cookies', app: 'Get the app', tagline: 'Free business calculators', alsoBy: 'Also by us' }
  : { about: 'О нас', contact: 'Контакты', press: 'Пресса', privacy: 'Приватность', terms: 'Условия', cookies: 'Cookies', app: 'Приложение', tagline: 'Бесплатные бизнес-калькуляторы', alsoBy: 'Также от нас' };
const appPath = lang === 'en' ? '/app' : '/ru/app';
const sisters = projects.map((p) => ({ name: p.name, href: projectUrl(p.url, 'footer') }));
---
<footer>
  <a href={home} class="flogo">Rate<span>Kit</span></a>
  <span class="fcopy">© 2026 RateKit · {labels.tagline}<br/><span class="fmore">{labels.alsoBy}: {sisters.map((s, i) => (<>{i > 0 && ' · '}<a href={s.href} target="_blank" rel="noopener">{s.name}</a></>))}</span></span>
  <ul class="flinks">
    <li><a href={appPath}>{labels.app}</a></li>
    <li><a href="/about">{labels.about}</a></li>
    <li><a href="/contact">{labels.contact}</a></li>
    <li><a href="/press">{labels.press}</a></li>
    <li><a href="/privacy">{labels.privacy}</a></li>
    <li><a href="/terms">{labels.terms}</a></li>
    <li><a href="/cookies">{labels.cookies}</a></li>
  </ul>
</footer>

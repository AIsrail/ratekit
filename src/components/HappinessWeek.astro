    tipNone: 'Your plans already cover everything. Enjoy the week.',
    lastCard: 'Last week',
    planCard: 'This week',
    longTitle: 'Habits linked with a longer life',
    longIntro: 'Researchers keep finding the same themes in people who live long and well. These are associations from observational studies, not guarantees, and this page does not predict how long you will live.',
    longItems: [
      'Something that gives inner support: faith, prayer, meditation, or time to reflect on what you do',
      'A hobby or interest that absorbs you',
      'Regular contact with people: friends, a club, a community',
      'Regular, simple, healthy meals (they do not have to be expensive)',
      'Daily movement: a walk, exercise, time outside',

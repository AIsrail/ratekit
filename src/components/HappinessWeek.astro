---
// Weekly happiness check-in: two columns of ticks (last week / this week's plan) and a
// smiley scale for each. No scores, nothing stored. Shared by the EN and RU pages.
interface Props { lang: 'en' | 'ru' }
const { lang } = Astro.props;

const faces = ['😔', '😐', '🙂', '😊', '😄'];

const copy = {
  en: {
    panelTitle: 'Your week',
    panelHint: 'Tick what happened last week and what you would like this week. Leave a box empty if it does not apply. There are no points and nothing is saved.',

---
import { tools, sectionLabel, type Section } from '../data/tools';

interface Props {
  lang: 'en' | 'ru';
  /** slug of the tool page currently rendering, for the active-link highlight */
  activeSlug?: string;
  /** where the language-switch link in the nav should point */
  altLangPath: string;
}

const { lang, activeSlug, altLangPath } = Astro.props;

const sections: Section[] = ['featured', 'freelancers', 'business', 'startups', 'fun'];

function visibleItems(section: Section) {
  return tools.filter((t) => {
    if (t.section !== section) return false;
    if (lang === 'en') return true;
    return Boolean(t.ru) || Boolean(t.usOnly);
  });
}
---
<nav id="nav">
  <a href={lang === 'en' ? '/' : '/ru'} class="logo">Rate<span>Kit</span></a>
  <div class="nav-r">
    <button type="button" class="translate-btn" id="nav-install" style="display:none;margin-left:0;" title={lang === 'en' ? 'Install RateKit as an app' : 'Установить RateKit как приложение'}>⬇ {lang === 'en' ? 'Install' : 'Установить'}</button>
    <a href={altLangPath} class="translate-btn" title={lang === 'en' ? 'Русская версия' : 'Switch to English'}>
      {lang === 'en' ? 'RU' : 'EN'}
    </a>
    <div class="dropdown" id="tools-dropdown" data-dropdown-init="1">
      <button class="dropdown-btn" data-dropdown-toggle>
        🧮 {lang === 'en' ? 'All Tools' : 'Все инструменты'} <span class="arrow">▾</span>
      </button>
      <div class="dropdown-menu">
        {sections.map((section, i) => {
          const items = visibleItems(section);
          if (items.length === 0) return null;
          return (
            <>
              {i > 0 && <div class="dropdown-divider" />}
              <div class="dropdown-section">{sectionLabel[section][lang]}</div>
              {items.map((t) => {
                const useRu = lang === 'ru' && t.ru;
                const href = useRu ? t.ru!.path : t.en.path;
                const label = useRu ? t.ru!.label : t.en.label;
                const isActive = t.slug === activeSlug;
                const isUsOnlyInRu = lang === 'ru' && !t.ru && t.usOnly;
                return (
                  <a href={href} class={`dropdown-item${isActive ? ' active' : ''}`}>
                    <span class="item-icon">{t.icon}</span>{label}
                    {isUsOnlyInRu && <span class="en-flag">US только</span>}
                  </a>
                );
              })}
            </>
          );
        })}
        <div class="dropdown-divider" />
        <a href={lang === 'en' ? '/glossary' : '/ru/glossary'} class="dropdown-item"><span class="item-icon">📖</span>{lang === 'en' ? 'Glossary' : 'Глоссарий'}</a>
      </div>
    </div>
  </div>
</nav>

<script>
  // The dropdown button already works standalone on mobile, so there's no separate
  // burger/hamburger control — just one toggle, plus outside-click to close.
  document.querySelectorAll('[data-dropdown-toggle]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      document.getElementById('tools-dropdown')?.classList.toggle('open');
    });
  });
  document.addEventListener('click', (e) => {
    const dd = document.getElementById('tools-dropdown');
    if (dd && !dd.contains(e.target)) dd.classList.remove('open');
  });

  // Install prompt and offline support, on every page. The prompt is kept on window so the
  // /app page and the calculators can use it too.
  const installBtn = document.getElementById('nav-install');
  const standalone = matchMedia('(display-mode: standalone)').matches || navigator.standalone;
  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    window.rkInstallPrompt = e;
    window.dispatchEvent(new Event('rk:installable'));
    if (installBtn && !standalone) installBtn.style.display = '';
  });
  window.addEventListener('appinstalled', () => {
    window.rkInstallPrompt = null;
    if (installBtn) installBtn.style.display = 'none';
  });
  installBtn?.addEventListener('click', async () => {
    const p = window.rkInstallPrompt;
    if (!p) return;
    p.prompt();
    await p.userChoice;
    window.rkInstallPrompt = null;
    installBtn.style.display = 'none';
  });

  const secure = location.protocol === 'https:' || location.hostname === 'localhost';
  if ('serviceWorker' in navigator && secure && window.self === window.top) {
    navigator.serviceWorker.register('/sw.js').then(() => navigator.serviceWorker.ready).then((reg) => {
      const urls = new Set(['/favicon-32x32.png', '/favicon-180x180.png', '/favicon-192x192.png', '/favicon-512x512.png', '/favicon.ico', '/manifest.webmanifest']);
      document.querySelectorAll('link[rel="stylesheet"], script[src]').forEach((n) => { const u = n.href || n.src; if (u) urls.add(u); });
      performance.getEntriesByType('resource').forEach((r) => { if (/\/_astro\/|fonts\.googleapis|fonts\.gstatic/.test(r.name)) urls.add(r.name); });
      // Only our own files and Google Fonts; never analytics or ad scripts.
      const allowed = (u) => {
        try {
          const x = new URL(u, location.href);
          return x.origin === location.origin || x.hostname === 'fonts.googleapis.com' || x.hostname === 'fonts.gstatic.com';
        } catch (e) { return false; }
      };
      (reg.active || navigator.serviceWorker.controller)?.postMessage({ type: 'cache-urls', urls: [...urls].filter(allowed) });
    }).catch(() => {});
  }
</script>

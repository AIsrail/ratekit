---
// "Calculator for everyone": the Pebble Calculator seen through simplified vision and colour
// filters, plus helpful modes for dyslexia, dyscalculia and dysgraphia. Illustrative only.
import CalcApp from './CalcApp.astro';

interface Props { lang: 'en' | 'ru' }
const { lang } = Astro.props;

const copy = {
  en: {
    discTitle: 'Please read first',
    disc: 'These views are simplified illustrations. In real life the experience can be completely different from what is shown here, and it varies enormously from person to person. They are not medical simulations and they do not speak for anyone. The "what helps" ideas are general suggestions, not advice for any one person.',
    seeTitle: 'See the calculator through different eyes',
    seeHint: 'Pick one option from each row. You can still press the keys.',
    visionTitle: 'Vision',
    colorTitle: 'Colour vision',
    vision: [
      ['normal', 'Typical'],
      ['mild', 'Mild blur (about −2 D)'],
      ['strong', 'Strong blur (about −5 D)'],
      ['severe', 'Severe blur (about −10 D)'],
      ['cataract', 'Hazy, like cataract'],
      ['tunnel', 'Tunnel vision'],
      ['central', 'Central blind spot'],
      ['lowcontrast', 'Low contrast'],
    ],
    color: [
      ['normal', 'Typical'],
      ['protan', 'Red-weak (protan)'],
      ['deutan', 'Green-weak (deutan)'],
      ['tritan', 'Blue-weak (tritan)'],
      ['achroma', 'No colour'],
    ],
    viewing: 'Showing',
    reset: 'Reset',
    visionNote: 'Blur is a rough stand-in for how sharp text looks; glasses or lenses often correct it. Real sight loss can also change brightness, glare, depth and much more.',
    colorNote: 'Colour filters are approximations. Many people see some colours better than these filters show.',
    helpTitle: 'Reading, numbers and writing',
    helpIntro: 'These conditions are not something a filter can show. Instead, here is what can be hard and what can help. Switch a helper on and it changes the calculator above.',
    hard: 'Can be hard',
    helps: 'What can help',
    on: 'On',
    off: 'Off',
    dys: {
      title: 'Dyslexia',
      hard: 'Reading and telling similar shapes apart. Some digits look alike and are easy to mix up.',
      help: ['Clear, evenly spaced digits', 'Generous space between characters', 'Less crowding on screen'],
      toggle: 'Dyslexia-friendly view',
      pairs: [['6', '9'], ['2', '5'], ['3', '8'], ['1', '7']],
      pairsCap: 'Digits that are easy to mix up',
    },
    disc2: {
      title: 'Dyscalculia',
      hard: 'Seeing how big a number is, and the value of each digit. A long row of digits can be hard to make sense of.',
      help: ['Show the place of each digit', 'Group digits in threes', 'Keep a tape so nothing has to be held in the head'],
      toggle: 'Show place value',
      rawCap: 'Hard to judge at a glance',
      placeCap: 'Clearer with each place shown',
      placeEmpty: 'Type a number to see its places.',
      tooBig: 'Too long to break down here.',
    },
    dysg: {
      title: 'Dysgraphia',
      hard: 'Writing and precise hand movements. Small keys and exact taps can be tiring, and copying numbers by hand is slow.',
      help: ['Large keys with room between them', 'Copy and paste instead of writing numbers out', 'A tape that remembers the sums'],
      toggle: 'Large keys',
      smallCap: 'Small target',
      bigCap: 'Large target',
    },
    places: ['ones', 'tens', 'hundreds', 'thousands', 'ten thousands', 'hundred thousands', 'millions', 'ten millions', 'hundred millions'],
    frac: ['tenths', 'hundredths', 'thousandths'],
    endDisc: 'Remember: this is a simplified picture, and real experiences can be entirely different. If you are building something for others, the best guide is to ask people who live with these conditions.',
  },
  ru: {
    discTitle: 'Прочитайте сначала',
    disc: 'Эти картинки — упрощённые иллюстрации. В реальности всё может быть абсолютно по-другому, и у каждого человека по-своему. Это не медицинские симуляции, и они не говорят от имени кого-либо. Идеи в блоках «что может помочь» — общие предложения, а не совет для конкретного человека.',
    seeTitle: 'Посмотрите на калькулятор другими глазами',
    seeHint: 'Выберите по одному варианту в каждой строке. Кнопки по-прежнему можно нажимать.',
    visionTitle: 'Зрение',
    colorTitle: 'Цветовое зрение',
    vision: [
      ['normal', 'Типичное'],
      ['mild', 'Лёгкое размытие (около −2 D)'],
      ['strong', 'Сильное размытие (около −5 D)'],
      ['severe', 'Очень сильное размытие (около −10 D)'],
      ['cataract', 'Мутная картинка, как при катаракте'],
      ['tunnel', 'Туннельное зрение'],
      ['central', 'Пятно в центре'],
      ['lowcontrast', 'Низкий контраст'],
    ],
    color: [
      ['normal', 'Типичное'],
      ['protan', 'Слабый красный (протан)'],
      ['deutan', 'Слабый зелёный (дейтан)'],
      ['tritan', 'Слабый синий (тритан)'],
      ['achroma', 'Без цвета'],
    ],
    viewing: 'Сейчас показано',
    reset: 'Сбросить',
    visionNote: 'Размытие лишь грубо показывает, насколько чёткий текст; очки или линзы часто это исправляют. Реальная потеря зрения может менять также яркость, блики, глубину и многое другое.',
    colorNote: 'Цветовые фильтры — приближения. Многие люди различают часть цветов лучше, чем показывают эти фильтры.',
    helpTitle: 'Чтение, числа и письмо',
    helpIntro: 'Эти особенности нельзя показать фильтром. Поэтому здесь описано, что может быть трудно и что может помочь. Включите помощник, и калькулятор выше изменится.',
    hard: 'Что может быть трудно',
    helps: 'Что может помочь',
    on: 'Вкл',
    off: 'Выкл',
    dys: {
      title: 'Дислексия',
      hard: 'Чтение и различение похожих форм. Некоторые цифры похожи друг на друга, и их легко перепутать.',
      help: ['Чёткие цифры с ровными интервалами', 'Больше места между символами', 'Меньше скученности на экране'],
      toggle: 'Вид для дислексии',
      pairs: [['6', '9'], ['2', '5'], ['3', '8'], ['1', '7']],
      pairsCap: 'Цифры, которые легко перепутать',
    },
    disc2: {
      title: 'Дискалькулия',
      hard: 'Понять, насколько велико число и какой вес у каждой цифры. Длинный ряд цифр трудно осмыслить.',
      help: ['Показывать разряд каждой цифры', 'Группировать цифры по три', 'Вести ленту, чтобы ничего не держать в голове'],
      toggle: 'Показать разряды',
      rawCap: 'Трудно оценить с первого взгляда',
      placeCap: 'Яснее, когда виден каждый разряд',
      placeEmpty: 'Введите число, чтобы увидеть разряды.',
      tooBig: 'Слишком длинное, чтобы разобрать здесь.',
    },
    dysg: {
      title: 'Дисграфия',
      hard: 'Письмо и точные движения руки. Мелкие клавиши и точные нажатия утомляют, а переписывать числа вручную долго.',
      help: ['Крупные клавиши с промежутками', 'Копировать и вставлять числа, а не выписывать', 'Лента, которая запоминает вычисления'],
      toggle: 'Крупные клавиши',
      smallCap: 'Маленькая цель',
      bigCap: 'Большая цель',
    },
    places: ['единицы', 'десятки', 'сотни', 'тысячи', 'десятки тысяч', 'сотни тысяч', 'миллионы', 'десятки миллионов', 'сотни миллионов'],
    frac: ['десятые', 'сотые', 'тысячные'],
    endDisc: 'Помните: это упрощённая картинка, а реальный опыт может быть совсем другим. Если вы делаете что-то для других, лучший ориентир — спрашивать людей, которые живут с этими особенностями.',
  },
}[lang];

const jsData = {
  places: copy.places,
  frac: copy.frac,
  placeEmpty: copy.disc2.placeEmpty,
  tooBig: copy.disc2.tooBig,
  viewing: copy.viewing,
  on: copy.on,
  off: copy.off,
  visionNames: Object.fromEntries(copy.vision),
  colorNames: Object.fromEntries(copy.color),
  normal: copy.vision[0][1],
};
---
<style is:global>
  html body { background: radial-gradient(circle at 6% 8%, #E4DDFB 0, transparent 42%), radial-gradient(circle at 94% 10%, #D6EAF9 0, transparent 42%), radial-gradient(circle at 50% 104%, #D9F2E5 0, transparent 52%), #F8F8FC; background-attachment: fixed; }
  html .page-header { background: transparent; border-bottom: none; }
  html .page-header::before { display: none; }
  html .page-sub { font-size: 17px; color: var(--mid); }
  html:root { --muted: #566073; }
  html .panel-title { font-size: 13px; color: var(--mid); }

  .al-disc { border: 2px solid var(--blue); background: var(--bluebg); border-radius: var(--radius); padding: 18px 22px; margin-bottom: 20px; font-size: 15px; line-height: 1.65; color: var(--ink); }
  .al-disc strong { display: block; margin-bottom: 4px; color: var(--blue); }
  .al-row { margin-bottom: 14px; }
  .al-row-title { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--mid); margin-bottom: 8px; }
  .al-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .al-chip { border: 2px solid #8A94A6; background: #fff; color: var(--ink); border-radius: 99px; padding: 8px 14px; font-family: var(--font); font-size: 14px; font-weight: 600; cursor: pointer; }
  .al-chip:hover { border-color: var(--blue); }
  .al-chip[aria-pressed="true"] { background: var(--blue); border-color: var(--blue); color: #fff; }
  .al-note { font-size: 13.5px; color: var(--mid); line-height: 1.6; margin: 6px 0 0; }
  .al-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-size: 14px; color: var(--mid); margin: 6px 0 14px; }
  .al-bar strong { color: var(--ink); }

  .al-stage { position: relative; border-radius: 24px; overflow: hidden; margin-bottom: 20px; }
  .al-view { transition: filter .25s var(--ease); }
  .al-overlay { position: absolute; inset: 0; pointer-events: none; z-index: 5; }
  .al-overlay[data-o="cataract"] { background: rgba(250, 248, 240, .42); backdrop-filter: blur(1.5px); }
  .al-overlay[data-o="tunnel"] { background: radial-gradient(ellipse 34% 40% at 50% 50%, rgba(0,0,0,0) 0, rgba(0,0,0,0) 62%, rgba(0,0,0,.96) 100%); }
  .al-overlay[data-o="central"]::after { content: ''; position: absolute; left: 50%; top: 50%; width: 36%; height: 36%; transform: translate(-50%, -50%); border-radius: 50%; background: radial-gradient(circle, rgba(70,70,76,.96) 0, rgba(70,70,76,.92) 55%, rgba(70,70,76,0) 100%); filter: blur(10px); }
  @media (max-width: 820px) { .al-overlay[data-o="central"]::after { width: 52%; height: 22%; } .al-overlay[data-o="tunnel"] { background: radial-gradient(ellipse 60% 26% at 50% 50%, rgba(0,0,0,0) 0, rgba(0,0,0,0) 62%, rgba(0,0,0,.96) 100%); } }

  .al-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-bottom: 20px; }
  .al-card { background: var(--white); border: 1.5px solid var(--border); border-radius: var(--radius); padding: 20px; box-shadow: 0 8px 24px rgba(11,12,20,.05); display: flex; flex-direction: column; gap: 12px; }
  .al-card h3 { font-size: 1.15rem; margin: 0; }
  .al-label { font-size: 11.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--mid); margin-bottom: 4px; }
  .al-card p, .al-card li { font-size: 14.5px; line-height: 1.6; color: var(--ink); margin: 0; }
  .al-card ul { margin: 0 0 0 18px; padding: 0; }
  .al-demo { background: var(--bg); border-radius: 12px; padding: 12px; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: center; }
  .al-cap { font-size: 12.5px; color: var(--mid); text-align: center; width: 100%; }
  .al-pair { display: inline-flex; align-items: center; gap: 4px; background: #fff; border: 1.5px solid var(--border); border-radius: 10px; padding: 6px 10px; font-family: var(--mono); font-size: 22px; font-weight: 600; }
  .al-pair span:nth-child(2) { color: var(--muted); font-size: 14px; }
  .al-raw { font-family: var(--mono); font-size: 26px; font-weight: 600; letter-spacing: -.02em; }
  .al-places { display: flex; gap: 4px; flex-wrap: wrap; justify-content: center; }
  .al-place { text-align: center; border-radius: 10px; padding: 6px 8px; min-width: 52px; color: #fff; }
  .al-place b { display: block; font-family: var(--mono); font-size: 20px; line-height: 1.1; }
  .al-place small { display: block; font-size: 10.5px; opacity: .95; line-height: 1.2; }
  .al-place.zero { opacity: .45; }
  .al-target { display: inline-flex; flex-direction: column; align-items: center; gap: 6px; font-size: 12.5px; color: var(--mid); }
  .al-dot { border-radius: 50%; background: var(--blue); display: block; }
  .al-toggle { align-self: flex-start; }
  .al-place-panel { background: var(--white); border: 1.5px solid var(--border); border-radius: var(--radius); padding: 18px 20px; margin-bottom: 20px; }
  .al-place-panel[hidden] { display: none; }
  .al-end { font-size: 14.5px; color: var(--mid); line-height: 1.65; margin-bottom: 20px; }

  /* Helper modes applied to the calculator */
  .al-view.m-dys .pc-main, .al-view.m-dys .pc-sub, .al-view.m-dys .pc-res, .al-view.m-dys .pc-expr, .al-view.m-dys .pc-key { font-family: Verdana, Tahoma, 'Trebuchet MS', sans-serif; letter-spacing: .1em; font-variant-numeric: slashed-zero; }
  .al-view.m-dys .pc-main { font-size: 3.2rem; line-height: 1.4; }
  .al-view.m-dys .pc-line { padding: 16px 2px; }
  .al-view.m-dys .pc-keys { gap: 16px; }
  .al-view.m-big .pc-key { min-height: 92px; font-size: 2rem; }
  .al-view.m-big .pc-keys { gap: 20px; }
  .al-view.m-big .pc-mini, .al-view.m-big .pc-theme { min-height: 46px; }
  .al-view.m-big .pc-theme { width: 40px; height: 40px; }

  @media (max-width: 820px) { .al-cards { grid-template-columns: minmax(0, 1fr); } .al-view.m-big .pc-key { min-height: 78px; } }
</style>

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <filter id="cvd-protan" color-interpolation-filters="sRGB"><feColorMatrix type="matrix" values="0.152286 1.052583 -0.204868 0 0  0.114503 0.786281 0.099216 0 0  -0.003882 -0.048116 1.051998 0 0  0 0 0 1 0" /></filter>
    <filter id="cvd-deutan" color-interpolation-filters="sRGB"><feColorMatrix type="matrix" values="0.367322 0.860646 -0.227968 0 0  0.280085 0.672501 0.047413 0 0  -0.011820 0.042940 0.968881 0 0  0 0 0 1 0" /></filter>
    <filter id="cvd-tritan" color-interpolation-filters="sRGB"><feColorMatrix type="matrix" values="1.255528 -0.076749 -0.178779 0 0  -0.078411 0.930809 0.147602 0 0  0.004733 0.691367 0.303900 0 0  0 0 0 1 0" /></filter>
    <filter id="cvd-achroma" color-interpolation-filters="sRGB"><feColorMatrix type="matrix" values="0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0 0 0 1 0" /></filter>
  </defs>
</svg>

<div class="al-disc" role="note"><strong>{copy.discTitle}</strong>{copy.disc}</div>

<div class="panel">
  <div class="panel-title">{copy.seeTitle}</div>
  <p class="al-note" style="margin:-6px 0 14px;">{copy.seeHint}</p>
  <div class="al-row">
    <div class="al-row-title">{copy.visionTitle}</div>
    <div class="al-chips" role="group" aria-label={copy.visionTitle}>
      {copy.vision.map(([id, name]) => <button type="button" class="al-chip" data-vision={id} aria-pressed={id === 'normal' ? 'true' : 'false'}>{name}</button>)}
    </div>
    <p class="al-note">{copy.visionNote}</p>
  </div>
  <div class="al-row">
    <div class="al-row-title">{copy.colorTitle}</div>
    <div class="al-chips" role="group" aria-label={copy.colorTitle}>
      {copy.color.map(([id, name]) => <button type="button" class="al-chip" data-color={id} aria-pressed={id === 'normal' ? 'true' : 'false'}>{name}</button>)}
    </div>
    <p class="al-note">{copy.colorNote}</p>
  </div>
  <div class="al-bar">
    <span>{copy.viewing}: <strong id="al-now"></strong></span>
    <button type="button" class="pc-mini" id="al-reset" style="border:1.5px solid #8A94A6;background:#fff;border-radius:9px;padding:6px 12px;font-family:var(--font);font-weight:600;cursor:pointer;">{copy.reset}</button>
  </div>
</div>

<div class="al-stage" id="al-stage">
  <div class="al-view" id="al-view">
    <CalcApp lang={lang} compact />
  </div>
  <div class="al-overlay" id="al-overlay" data-o=""></div>
</div>

<div class="al-place-panel" id="al-place-panel" hidden>
  <div class="al-label">{copy.disc2.title}</div>
  <div class="al-places" id="al-places"></div>
</div>

<div class="panel">
  <div class="panel-title">{copy.helpTitle}</div>
  <p class="al-note" style="margin:-6px 0 16px;">{copy.helpIntro}</p>
  <div class="al-cards">
    <div class="al-card">
      <h3>{copy.dys.title}</h3>
      <div><div class="al-label">{copy.hard}</div><p>{copy.dys.hard}</p></div>
      <div class="al-demo">
        {copy.dys.pairs.map(([a, b]) => <span class="al-pair"><span>{a}</span><span>/</span><span>{b}</span></span>)}
        <div class="al-cap">{copy.dys.pairsCap}</div>
      </div>
      <div><div class="al-label">{copy.helps}</div><ul>{copy.dys.help.map((t) => <li>{t}</li>)}</ul></div>
      <button type="button" class="share-btn al-toggle" data-mode="m-dys" aria-pressed="false">{copy.dys.toggle}: <b>{copy.off}</b></button>
    </div>

    <div class="al-card">
      <h3>{copy.disc2.title}</h3>
      <div><div class="al-label">{copy.hard}</div><p>{copy.disc2.hard}</p></div>
      <div class="al-demo">
        <span class="al-raw">4070592</span>
        <div class="al-cap">{copy.disc2.rawCap}</div>
        <div class="al-places" id="al-demo-places"></div>
        <div class="al-cap">{copy.disc2.placeCap}</div>
      </div>
      <div><div class="al-label">{copy.helps}</div><ul>{copy.disc2.help.map((t) => <li>{t}</li>)}</ul></div>
      <button type="button" class="share-btn al-toggle" data-mode="place" aria-pressed="false">{copy.disc2.toggle}: <b>{copy.off}</b></button>
    </div>

    <div class="al-card">
      <h3>{copy.dysg.title}</h3>
      <div><div class="al-label">{copy.hard}</div><p>{copy.dysg.hard}</p></div>
      <div class="al-demo" style="gap:28px;">
        <span class="al-target"><span class="al-dot" style="width:24px;height:24px;"></span>{copy.dysg.smallCap}</span>
        <span class="al-target"><span class="al-dot" style="width:64px;height:64px;"></span>{copy.dysg.bigCap}</span>
      </div>
      <div><div class="al-label">{copy.helps}</div><ul>{copy.dysg.help.map((t) => <li>{t}</li>)}</ul></div>
      <button type="button" class="share-btn al-toggle" data-mode="m-big" aria-pressed="false">{copy.dysg.toggle}: <b>{copy.off}</b></button>
    </div>
  </div>
</div>

<p class="al-end">{copy.endDisc}</p>

<script type="application/json" id="al-data" set:html={JSON.stringify(jsData)} />

<script>
  const data = JSON.parse(document.getElementById('al-data').textContent);
  const $ = (id) => document.getElementById(id);
  const view = $('al-view'), overlay = $('al-overlay');

  const VISION = {
    normal: { f: '', o: '' },
    mild: { f: 'blur(1.5px)', o: '' },
    strong: { f: 'blur(4px)', o: '' },
    severe: { f: 'blur(8px)', o: '' },
    cataract: { f: 'blur(2px) contrast(.6) brightness(1.12) sepia(.3)', o: 'cataract' },
    tunnel: { f: '', o: 'tunnel' },
    central: { f: '', o: 'central' },
    lowcontrast: { f: 'contrast(.35) brightness(1.1)', o: '' },
  };
  let vision = 'normal', color = 'normal';

  function apply() {
    const parts = [];
    if (color !== 'normal') parts.push(`url(#cvd-${color})`);
    if (VISION[vision].f) parts.push(VISION[vision].f);
    view.style.filter = parts.join(' ') || 'none';
    overlay.dataset.o = VISION[vision].o;
    document.querySelectorAll('[data-vision]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.vision === vision)));
    document.querySelectorAll('[data-color]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.color === color)));
    const names = [];
    if (vision !== 'normal') names.push(data.visionNames[vision]);
    if (color !== 'normal') names.push(data.colorNames[color]);
    $('al-now').textContent = names.length ? names.join(' + ') : data.normal;
  }
  document.querySelectorAll('[data-vision]').forEach((b) => b.addEventListener('click', () => { vision = b.dataset.vision; apply(); }));
  document.querySelectorAll('[data-color]').forEach((b) => b.addEventListener('click', () => { color = b.dataset.color; apply(); }));
  $('al-reset').addEventListener('click', () => { vision = 'normal'; color = 'normal'; apply(); });

  // Place value: break the number on the calculator display into its places.
  const PALETTE = ['#3756F9', '#0D9668', '#D97706', '#7B5CFA', '#DC2626', '#0E7490', '#B45309', '#4F46E5', '#BE185D'];
  function chips(intDigits, fracDigits) {
    const frag = document.createDocumentFragment();
    const mk = (digit, label, color) => {
      const c = document.createElement('div');
      c.className = 'al-place' + (digit === '0' ? ' zero' : '');
      c.style.background = color;
      const b = document.createElement('b'); b.textContent = digit;
      const s = document.createElement('small'); s.textContent = label;
      c.append(b, s);
      return c;
    };
    intDigits.split('').forEach((d, i) => {
      const p = intDigits.length - 1 - i;
      frag.appendChild(mk(d, data.places[p], PALETTE[p % PALETTE.length]));
    });
    fracDigits.split('').slice(0, 3).forEach((d, i) => frag.appendChild(mk(d, data.frac[i], '#64748B')));
    return frag;
  }
  function parseDisplay() {
    const lang = document.documentElement.lang;
    let s = ($('pc-main').textContent || '').replace(/[−-]/g, '');
    s = lang === 'ru' ? s.replace(/[\s  ]/g, '').replace(',', '.') : s.replace(/,/g, '');
    if (!/^\d+(\.\d+)?$/.test(s)) return null;
    const [int, frac = ''] = s.split('.');
    return { int, frac };
  }
  function renderPlace() {
    const box = $('al-places');
    box.textContent = '';
    const n = parseDisplay();
    if (!n) { box.textContent = data.placeEmpty; return; }
    if (n.int.length > data.places.length) { box.textContent = data.tooBig; return; }
    box.appendChild(chips(n.int, n.frac));
  }
  $('al-demo-places').appendChild(chips('4070592', ''));
  new MutationObserver(renderPlace).observe($('pc-main'), { childList: true, characterData: true, subtree: true });
  renderPlace();

  // Helper modes
  document.querySelectorAll('[data-mode]').forEach((b) => b.addEventListener('click', () => {
    const mode = b.dataset.mode;
    const on = b.getAttribute('aria-pressed') !== 'true';
    b.setAttribute('aria-pressed', String(on));
    b.querySelector('b').textContent = on ? data.on : data.off;
    if (mode === 'place') $('al-place-panel').hidden = !on;
    else view.classList.toggle(mode, on);
  }));

  apply();
</script>

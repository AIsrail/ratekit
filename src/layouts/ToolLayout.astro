---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { toolBySlug } from '../data/tools';
import '../styles/base.css';

export interface FaqItem { q: string; a: string }
export interface RelatedItem { label: string; path: string }

interface Props {
  /** must match a slug in src/data/tools.ts */
  slug: string;
  lang: 'en' | 'ru';
  /** <title> text; " — RateKit" is appended automatically */
  title: string;
  description: string;
  /** small uppercase tag above the H1, e.g. "💰 Planning Tool" */
  pageTag: string;
  /** CSS color for pageTag, e.g. "var(--amber)" or "var(--blue)" — defaults to green */
  pageTagColor?: string;
  h1: string;
  pageSub: string;
  /** ISO date, e.g. '2026-10-13' — surfaced in JSON-LD and in the byline */
  dateModified: string;
  /** H2 above the prose guide section, e.g. "How to calculate your runway" */
  guideTitle: string;
  faq: FaqItem[];
  related: RelatedItem[];
  ogType?: 'article' | 'website';
}

const {
  slug, lang, title, description, pageTag, pageTagColor, h1, pageSub,
  dateModified, guideTitle, faq, related, ogType = 'article',
} = Astro.props;

const tool = toolBySlug(slug);
if (!tool) throw new Error(`ToolLayout: unknown slug "${slug}" — add it to src/data/tools.ts first`);

const path = lang === 'en' ? tool.en.path : tool.ru?.path;
if (!path) throw new Error(`ToolLayout: tool "${slug}" has no ${lang} path in src/data/tools.ts`);

const canonical = `https://ratekit.org${path}`;
const altLangPath = lang === 'en' ? (tool.ru?.path ?? tool.en.path) : tool.en.path;
const fullTitle = `${title} — RateKit`;
const breadcrumbHome = lang === 'en' ? 'RateKit' : 'RateKit';
const htmlLang = lang;
const locale = lang === 'en' ? 'en_US' : 'ru_RU';
const altLocale = lang === 'en' ? 'ru_RU' : 'en_US';

const ldGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: title,
      description,
      url: canonical,
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Web',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      dateModified,
      author: { '@type': 'Person', name: 'Azat Israilov', url: 'https://ratekit.org/about' },
      provider: { '@type': 'Organization', name: 'RateKit', url: 'https://ratekit.org' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'RateKit', item: lang === 'en' ? 'https://ratekit.org/' : 'https://ratekit.org/ru' },
        { '@type': 'ListItem', position: 2, name: h1, item: canonical },
      ],
    },
    ...(faq.length > 0 ? [{
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }] : []),
  ],
};
---
<!DOCTYPE html>
<html lang={htmlLang}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/favicon-180x180.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style is:global>
.page-header{position:relative;background:var(--white);border-bottom:1px solid var(--border-soft);padding:52px 48px 44px;overflow:hidden;}
.page-header::before{content:'';position:absolute;top:-120px;right:-80px;width:360px;height:360px;background:radial-gradient(circle,rgba(55,86,249,.08),rgba(123,92,250,.05) 55%,transparent 72%);pointer-events:none;}
.breadcrumb{position:relative;display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted);margin-bottom:18px;}
.breadcrumb a{color:var(--blue);}
.page-tag{position:relative;display:inline-flex;align-items:center;font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--page-tag-color, var(--green));background:color-mix(in srgb, var(--page-tag-color, var(--green)) 10%, white);padding:5px 12px;border-radius:99px;margin-bottom:14px;}
h1{position:relative;font-size:clamp(1.65rem,3.5vw,2.5rem);font-weight:700;letter-spacing:-.025em;line-height:1.12;margin-bottom:10px;}
.page-sub{position:relative;font-size:15px;color:var(--mid);max-width:560px;}
main{padding:40px 48px 64px;max-width:900px;}
.panel{background:var(--white);border:1px solid var(--border);border-radius:12px;padding:28px;margin-bottom:20px;}
.panel-title{font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:20px;padding-bottom:12px;border-bottom:1px solid var(--border);}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;}
.field{margin-bottom:16px;}
.lbl{display:block;font-size:12px;font-weight:600;color:var(--mid);margin-bottom:6px;}
.hint{font-weight:400;color:var(--muted);}
.input-wrap{display:flex;align-items:center;border:1.5px solid var(--border);border-radius:8px;background:var(--white);overflow:hidden;transition:border-color .15s;}
.input-wrap:focus-within{border-color:var(--blue);}
.ifix{font-family:var(--mono);font-size:13px;color:var(--muted);padding:10px 12px;background:var(--bg);border-right:1px solid var(--border);white-space:nowrap;}
.ifix-r{border-right:none;border-left:1px solid var(--border);}
input[type="number"]{flex:1;background:transparent;border:none;outline:none;color:var(--ink);font-family:var(--mono);font-size:14px;padding:10px 12px;width:100%;-moz-appearance:textfield;}
input[type="number"]::-webkit-outer-spin-button,input[type="number"]::-webkit-inner-spin-button{-webkit-appearance:none;}
.results-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin-bottom:20px;}
.r-card{background:var(--white);border:1.5px solid var(--border);border-radius:var(--radius);padding:22px;box-shadow:var(--shadow-xs);transition:box-shadow .2s var(--ease);}
.r-card.primary{background:linear-gradient(135deg,var(--blue),var(--blue2));border-color:var(--blue);box-shadow:var(--shadow-glow);}
.r-card.green{background:var(--greenbg);border-color:#6EE7B7;}
.r-card.red{background:var(--redbg);border-color:#FECACA;}
.r-card.amber{background:#FFFBEB;border-color:#FDE68A;}
.r-card.amber .r-label{color:var(--amber);}
.r-card.amber .r-value{color:var(--amber);}
.r-card.highlight{background:var(--greenbg);border-color:#6EE7B7;}
.r-card.highlight .r-label{color:var(--green);}
.r-label{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:8px;}
.r-card.primary .r-label{color:rgba(255,255,255,.6);}
.r-card.green .r-label{color:var(--green);}
.r-card.red .r-label{color:var(--red);}
.r-value{font-family:var(--mono);font-size:clamp(1.3rem,2.5vw,1.9rem);font-weight:600;color:var(--ink);line-height:1;}
.r-card.primary .r-value{color:white;}
.r-card.green .r-value{color:var(--green);}
.r-card.red .r-value{color:var(--red);}
.r-sub{font-size:11px;color:var(--muted);margin-top:6px;}
.r-card.primary .r-sub{color:rgba(255,255,255,.5);}
.verdict{padding:16px 20px;border-radius:10px;font-size:14px;font-weight:500;margin-bottom:20px;line-height:1.6;}
.info-box{background:var(--bluebg);border:1px solid #BFDBFE;border-radius:10px;padding:16px 20px;font-size:13px;color:var(--mid);line-height:1.7;margin-bottom:20px;}
.info-box strong{color:var(--blue);}
.bench-table{width:100%;border-collapse:collapse;margin:0 0 16px;font-size:13.5px;}
.bench-table th,.bench-table td{text-align:left;padding:8px 10px;border-bottom:1px solid var(--border);}
.bench-table th{font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);}
.bench-table td:last-child,.bench-table th:last-child{text-align:right;font-family:var(--mono);}

/* ── Reusable tool widgets (shared across multiple calculators) ── */
.mode-toggle{display:flex;border:1.5px solid var(--border);border-radius:8px;overflow:hidden;margin-bottom:24px;}
.mode-btn{flex:1;padding:10px;background:transparent;border:none;font-family:var(--font);font-size:13px;font-weight:500;color:var(--mid);cursor:pointer;transition:all .15s;}
.mode-btn.active{background:var(--blue);color:white;}
select{flex:1;background:transparent;border:none;outline:none;color:var(--ink);font-family:var(--font);font-size:14px;padding:10px 12px;cursor:pointer;}

.bench-panel{background:var(--white);border:1px solid var(--border);border-radius:12px;padding:28px;margin-bottom:20px;}
.bench-row{display:flex;align-items:center;gap:14px;padding:10px 0;border-bottom:1px solid var(--border);}
.bench-row:last-child{border-bottom:none;}
.bench-name{font-size:13px;color:var(--mid);width:180px;flex-shrink:0;}
.bench-range{font-family:var(--mono);font-size:12px;font-weight:600;width:70px;flex-shrink:0;}
.bench-bar-wrap{flex:1;height:5px;background:var(--bg);border-radius:99px;overflow:hidden;}
.bench-bar{height:100%;border-radius:99px;}

.rates-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:8px;margin-top:4px;}
.rate-chip{background:var(--bg);border:1.5px solid var(--border);border-radius:8px;padding:10px 14px;cursor:pointer;transition:all .15s;font-size:13px;}
.rate-chip:hover{border-color:var(--blue);}
.rate-chip.active{border-color:var(--blue);background:var(--bluebg);color:var(--blue);}
.rate-chip .country{font-weight:600;font-size:12px;}
.rate-chip .rate{font-family:var(--mono);font-size:11px;color:var(--muted);}

.chart-panel{background:var(--white);border:1px solid var(--border);border-radius:12px;padding:28px;margin-bottom:20px;}
.chart-title{font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:20px;padding-bottom:12px;border-bottom:1px solid var(--border);}
.chart-panel canvas{width:100%;height:220px;display:block;}

.table-panel{background:var(--white);border:1px solid var(--border);border-radius:12px;padding:28px;margin-bottom:20px;}
.table-title{font-size:11px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:18px;padding-bottom:12px;border-bottom:1px solid var(--border);}
.table-panel table{width:100%;border-collapse:collapse;font-size:13px;}
.table-panel thead th{text-align:left;font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);padding:8px 12px;background:var(--bg);border-bottom:1px solid var(--border);}
.table-panel tbody td{padding:10px 12px;border-bottom:1px solid var(--border);color:var(--mid);}
.table-panel tbody td.mono{font-family:var(--mono);}
.table-panel tbody td.profit{color:var(--green);font-weight:600;}
.table-panel tbody td.loss{color:var(--red);font-weight:600;}
.table-panel tbody tr.breakeven-row td{background:#FFFBEB;font-weight:600;}
.table-panel tbody td.danger{color:var(--red);font-weight:600;}
.table-panel tbody tr.total td{background:var(--bluebg);font-weight:600;color:var(--blue);}

.runway-panel{background:var(--white);border:1px solid var(--border);border-radius:12px;padding:28px;margin-bottom:20px;}
.rw-bar-wrap{margin-top:16px;}
.rw-bar-track{height:12px;background:var(--bg);border-radius:99px;overflow:hidden;margin-bottom:8px;}
.rw-bar-fill{height:100%;border-radius:99px;transition:width .6s ease,background .3s;}
.rw-labels{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);}

.compare-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;}
.compare-panel{background:var(--white);border:2px solid var(--border);border-radius:12px;padding:24px;}
.compare-panel.w2{border-color:#6EE7B7;}
.compare-panel.c1099{border-color:#BFDBFE;}
.compare-header{display:flex;align-items:center;gap:10px;margin-bottom:20px;padding-bottom:14px;border-bottom:1px solid var(--border);}
.compare-badge{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:4px 10px;border-radius:4px;}
.compare-badge.w2{background:var(--greenbg);color:var(--green);}
.compare-badge.c1099{background:var(--bluebg);color:var(--blue);}
.compare-title{font-size:15px;font-weight:700;color:var(--ink);}
.verdict-panel{border-radius:12px;padding:24px 28px;margin-bottom:20px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;}
.verdict-panel.winner-w2{background:var(--greenbg);border:2px solid #6EE7B7;}
.verdict-panel.winner-1099{background:var(--bluebg);border:2px solid #BFDBFE;}
.verdict-panel.tie{background:#FFFBEB;border:2px solid #FDE68A;}
.verdict-text{font-size:16px;font-weight:700;color:var(--ink);}
.verdict-sub{font-size:13px;color:var(--mid);margin-top:4px;}
.verdict-diff{font-family:var(--mono);font-size:1.8rem;font-weight:700;}
.verdict-diff.green{color:var(--green);}
.verdict-diff.blue{color:var(--blue);}
.verdict-diff.amber{color:var(--amber);}
.results-table{width:100%;border-collapse:collapse;font-size:13px;}
.results-table th{text-align:left;font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);padding:8px 14px;background:var(--bg);border-bottom:1px solid var(--border);}
.results-table th:not(:first-child){text-align:right;}
.results-table td{padding:11px 14px;border-bottom:1px solid var(--border);color:var(--mid);font-size:13px;}
.results-table td:not(:first-child){font-family:var(--mono);text-align:right;color:var(--ink);}
.results-table tr:last-child td{border-bottom:none;}
.results-table tr.section-row td{background:var(--bg);font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);padding:6px 14px;}
.results-table tr.total-row td{font-weight:700;font-size:14px;background:var(--ink);color:white;}
.results-table tr.total-row td:not(:first-child){color:white;}
.results-table tr.highlight-row td{background:var(--greenbg);}
.results-table tr.highlight-row td:not(:first-child){color:var(--green);font-weight:600;}
.warn-box{background:#FFFBEB;border:1px solid #FDE68A;border-radius:10px;padding:16px 20px;font-size:13px;color:var(--mid);line-height:1.7;margin-bottom:20px;}
.warn-box strong{color:var(--amber);}
.proc-tabs{display:flex;gap:8px;margin-bottom:24px;flex-wrap:wrap;}
.proc-btn{padding:8px 16px;background:var(--white);border:1.5px solid var(--border);border-radius:8px;font-family:var(--font);font-size:13px;font-weight:500;color:var(--mid);cursor:pointer;transition:all .15s;}
.proc-btn.active{border-color:var(--blue);color:var(--blue);background:var(--bluebg);}
.big-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:20px;}
.quarterly-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:20px;}
.q-card{background:var(--white);border:1px solid var(--border);border-radius:10px;padding:16px;text-align:center;}
.q-label{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:6px;}
.q-date{font-size:11px;color:var(--amber);margin-bottom:8px;font-weight:500;}
.q-value{font-family:var(--mono);font-size:1.2rem;font-weight:600;color:var(--ink);}
@media(max-width:768px){.big-row,.quarterly-grid{grid-template-columns:1fr 1fr;}}

.amort-panel{background:var(--white);border:1px solid var(--border);border-radius:12px;padding:28px;margin-bottom:20px;overflow-x:auto;}
.amort-panel table{width:100%;border-collapse:collapse;font-size:12px;min-width:500px;}
.amort-panel thead th{text-align:left;font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);padding:8px 10px;background:var(--bg);border-bottom:1px solid var(--border);}
.amort-panel tbody td{padding:8px 10px;border-bottom:1px solid var(--border);color:var(--mid);}
.amort-panel tbody td.mono{font-family:var(--mono);color:var(--ink);}
.amort-panel tbody tr:last-child td{border-bottom:none;}

.ratio-panel{background:var(--white);border:1px solid var(--border);border-radius:12px;padding:32px;margin-bottom:20px;text-align:center;}
.ratio-value{font-family:var(--mono);font-size:clamp(3rem,8vw,5rem);font-weight:700;line-height:1;margin-bottom:8px;transition:color .3s;}
.ratio-label{font-size:14px;color:var(--mid);margin-bottom:16px;}
.ratio-verdict{display:inline-block;font-size:13px;font-weight:600;padding:6px 16px;border-radius:99px;}
.metrics-row{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px;}
.m-card{background:var(--white);border:1.5px solid var(--border);border-radius:12px;padding:20px;}
.m-label{font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:8px;}
.m-value{font-family:var(--mono);font-size:1.5rem;font-weight:600;color:var(--ink);line-height:1;}
.m-sub{font-size:11px;color:var(--muted);margin-top:6px;}
.bench-panel .bench-range{width:80px;}
.bench-panel .bench-label{font-size:13px;color:var(--mid);width:180px;flex-shrink:0;}
.bench-panel .bench-verdict{font-size:11px;font-weight:600;padding:3px 10px;border-radius:4px;}
@media(max-width:600px){.metrics-row{grid-template-columns:1fr 1fr;}}

.eligibility-panel{background:var(--white);border:1px solid var(--border);border-radius:12px;padding:24px;margin-bottom:20px;}
.check-row{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--border);font-size:13px;}
.check-row:last-child{border-bottom:none;}
.check-icon{font-size:18px;width:24px;flex-shrink:0;}
.check-label{flex:1;color:var(--mid);}
.check-status{font-weight:600;font-size:12px;}
.breakdown-panel{background:var(--white);border:1px solid var(--border);border-radius:12px;padding:28px;margin-bottom:20px;}
.breakdown-panel .bd-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--border);font-size:13px;}
.breakdown-panel .bd-row:last-child{border-bottom:none;font-weight:700;}
.breakdown-panel .bd-label{color:var(--mid);}
.breakdown-panel .bd-value{font-family:var(--mono);color:var(--ink);}
.table-panel tbody tr:last-child td{border-bottom:none;}
@media(max-width:768px){.page-header,main{padding-left:16px;padding-right:16px;}.results-row{grid-template-columns:1fr 1fr;}.grid-2{grid-template-columns:1fr;}}

/* ── Elevation pass: unify radius + soft shadow across every panel/card type ── */
.panel,.bench-panel,.chart-panel,.table-panel,.runway-panel,.breakdown-panel,.eligibility-panel,.amort-panel,.ratio-panel,.compare-panel,.verdict-panel{border-radius:var(--radius);box-shadow:var(--shadow-sm);}
.r-card,.m-card,.q-card{border-radius:var(--radius);box-shadow:var(--shadow-xs);}
.rate-chip,.proc-btn,.mode-btn,.bench-btn{transition:all .18s var(--ease);}

.share-bar{background:var(--white);border:1px solid var(--border);border-radius:var(--radius);padding:20px 24px;margin-top:20px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;box-shadow:var(--shadow-sm);}
.share-label{font-size:12px;font-weight:600;color:var(--muted);letter-spacing:.08em;text-transform:uppercase;}
.share-btns{display:flex;gap:8px;flex-wrap:wrap;}
.share-btn{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:var(--radius-sm);font-family:var(--font);font-size:12px;font-weight:600;cursor:pointer;border:1.5px solid var(--border);background:var(--white);color:var(--mid);transition:all .18s var(--ease);text-decoration:none;}
.share-btn:hover{border-color:var(--blue);color:var(--blue);background:var(--bluebg);transform:translateY(-1px);}
.share-btn.pdf-btn{background:linear-gradient(135deg,var(--blue),var(--blue2));color:white;border-color:var(--blue);box-shadow:var(--shadow-glow);}
.share-btn.pdf-btn:hover{filter:brightness(1.05);}
.share-btn.copied{background:var(--greenbg);color:var(--green);border-color:#6EE7B7;}
@media print{nav,.share-bar,footer{display:none!important;}body{background:white!important;}.page-header{border:none;padding:20px 0;}main{padding:20px 0;}.watermark-footer{display:block!important;position:fixed;bottom:10px;right:20px;font-size:11px;color:#94A3B8;font-family:sans-serif;}}
.watermark-footer{display:none;}

.rk-guide{margin-top:48px;padding-top:32px;border-top:1px solid var(--border-soft);max-width:780px}
.rk-guide h2{font-size:1.5rem;font-weight:700;letter-spacing:-.015em;margin:0 0 14px}
.rk-guide h3{font-size:1.08rem;font-weight:700;margin:28px 0 10px}
.rk-guide p{margin:0 0 12px;color:var(--mid)}
.rk-guide pre{white-space:pre-wrap;background:var(--bg);border-radius:10px;padding:14px 16px;font-size:.92rem;line-height:1.55;margin:0 0 12px;font-family:inherit}
.rk-guide details{border-bottom:1px solid var(--border-soft);padding:14px 0}
.rk-guide summary{cursor:pointer;font-weight:600}
.rk-guide details p{margin:10px 0 0}
.rk-byline{font-size:12px;color:var(--muted);margin-top:24px;}
.rk-byline a{color:var(--blue);}
.rk-related{display:flex;flex-wrap:wrap;gap:8px;list-style:none;padding:0;margin:0}
.rk-related a{display:inline-block;padding:7px 14px;border:1px solid var(--border);border-radius:999px;text-decoration:none;color:var(--mid);font-size:.88rem;transition:all .18s var(--ease);}
.rk-related a:hover{border-color:var(--blue);color:var(--blue);background:var(--bluebg);}
@media print{.rk-guide{display:none}}
</style>

<meta property="og:type" content={ogType}>
<meta property="og:url" content={canonical}>
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description}>
<meta property="og:image" content="https://ratekit.org/og-image.png">
<meta property="og:site_name" content="RateKit — Business Calculators">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={fullTitle}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content="https://ratekit.org/og-image.png">

<link rel="canonical" href={canonical}>
<link rel="alternate" hreflang="en" href={`https://ratekit.org${tool.en.path}`}>
{tool.ru && <link rel="alternate" hreflang="ru" href={`https://ratekit.org${tool.ru.path}`}>}
<link rel="alternate" hreflang="x-default" href={`https://ratekit.org${tool.en.path}`}>

<script type="application/ld+json" set:html={JSON.stringify(ldGraph)} />

<script async src="https://www.googletagmanager.com/gtag/js?id=G-JZZPXY8N1E"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-JZZPXY8N1E');
</script>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7303101907130018" crossorigin="anonymous"></script>
<meta name="robots" content="index, follow, max-image-preview:large">
<meta property="og:locale" content={locale}>
<meta property="og:locale:alternate" content={altLocale}>
</head>
<body>
<Nav lang={lang} activeSlug={slug} altLangPath={altLangPath} />

<div class="page-header">
  <div class="breadcrumb"><a href={lang === 'en' ? '/' : '/ru'}>{breadcrumbHome}</a> › {h1}</div>
  <div class="page-tag" style={pageTagColor ? `--page-tag-color:${pageTagColor}` : undefined}>{pageTag}</div>
  <h1>{h1}</h1>
  <p class="page-sub">{pageSub}</p>
</div>

<main>
  <slot />

  <div class="share-bar" id="share-bar">
    <span class="share-label">{lang === 'en' ? 'Share or Export' : 'Поделиться'}</span>
    <div class="share-btns">
      <button class="share-btn" id="copy-link-btn" title="Copy link">🔗 {lang === 'en' ? 'Copy link' : 'Копировать ссылку'}</button>
      <a class="share-btn" id="tw-btn" href="#" target="_blank" rel="noopener">𝕏 Twitter</a>
      <a class="share-btn" id="li-btn" href="#" target="_blank" rel="noopener">in LinkedIn</a>
      <a class="share-btn" id="tg-btn" href="#" target="_blank" rel="noopener">✈️ Telegram</a>
      <a class="share-btn" id="wa-btn" href="#" target="_blank" rel="noopener">💬 WhatsApp</a>
      <button class="share-btn pdf-btn" id="pdf-btn">⬇ {lang === 'en' ? 'Save as PDF' : 'Сохранить PDF'}</button>
    </div>
  </div>
  <div class="watermark-footer">Generated with RateKit · ratekit.org · Free business calculators</div>

  <section class="rk-guide" aria-labelledby="rk-guide-h">
    <h2 id="rk-guide-h">{guideTitle}</h2>
    <slot name="guide" />

    {faq.length > 0 && <h3>{lang === 'en' ? 'Frequently asked questions' : 'Частые вопросы'}</h3>}
    {faq.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}

    {related.length > 0 && <h3>{lang === 'en' ? 'Related calculators' : 'Похожие калькуляторы'}</h3>}
    {related.length > 0 && (
      <ul class="rk-related">
        {related.map((r) => <li><a href={r.path}>{r.label}</a></li>)}
      </ul>
    )}

    <p class="rk-byline">
      {lang === 'en' ? 'Author: ' : 'Автор: '}<a href="/about">Azat Israilov</a>
      {' · '}{lang === 'en' ? 'Updated' : 'Обновлено'}: {dateModified}
    </p>
  </section>
</main>

<Footer lang={lang} />

<script>
  function getShareText() {
    const title = document.title.replace(' — RateKit', '');
    return `${title} — calculated with RateKit (free) 👉 ${window.location.href}`;
  }
  function copyLink(btn) {
    navigator.clipboard.writeText(window.location.href).then(() => {
      const original = btn.textContent;
      btn.textContent = '✅ Copied!';
      btn.classList.add('copied');
      setTimeout(() => {
        btn.textContent = original;
        btn.classList.remove('copied');
      }, 2000);
    });
  }
  document.getElementById('copy-link-btn')?.addEventListener('click', (e) => copyLink(e.currentTarget));
  document.getElementById('pdf-btn')?.addEventListener('click', () => window.print());

  function initShare() {
    const url = encodeURIComponent(window.location.href);
    const text = encodeURIComponent(getShareText());
    const tw = document.getElementById('tw-btn');
    const li = document.getElementById('li-btn');
    const tg = document.getElementById('tg-btn');
    const wa = document.getElementById('wa-btn');
    if (tw) tw.href = `https://twitter.com/intent/tweet?text=${text}`;
    if (li) li.href = `https://www.linkedin.com/sharing/share-offsite/?url=${url}`;
    if (tg) tg.href = `https://t.me/share/url?url=${url}&text=${text}`;
    if (wa) wa.href = `https://wa.me/?text=${text}`;
  }
  window.addEventListener('load', initShare);

  // Persist every number/select input under a key derived from the page path, and
  // restore on load — shared across every tool page, no per-page wiring needed.
  function saveInputs() {
    const key = 'rk_' + window.location.pathname.replace(/[^a-z0-9]/gi, '_');
    const inputs = {};
    document.querySelectorAll('input[type="number"], input[type="date"], select').forEach((el) => {
      if (el.id) inputs[el.id] = el.value;
    });
    localStorage.setItem(key, JSON.stringify(inputs));
  }
  function restoreInputs() {
    const key = 'rk_' + window.location.pathname.replace(/[^a-z0-9]/gi, '_');
    const saved = localStorage.getItem(key);
    if (!saved) return;
    try {
      const inputs = JSON.parse(saved);
      Object.keys(inputs).forEach((id) => {
        const el = document.getElementById(id);
        if (el) el.value = inputs[id];
      });
      document.dispatchEvent(new Event('rk:restored'));
    } catch (e) {}
  }
  document.addEventListener('input', saveInputs);
  document.addEventListener('change', saveInputs);
  window.addEventListener('load', restoreInputs);
</script>
</body>
</html>

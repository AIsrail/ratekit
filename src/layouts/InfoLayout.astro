---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/base.css';

interface Props {
  path: string;
  title: string;
  description: string;
  pageTag: string;
  h1: string;
  pageSub: string;
  breadcrumbLabel: string;
}

const { path, title, description, pageTag, h1, pageSub, breadcrumbLabel } = Astro.props;
const canonical = `https://ratekit.org${path}`;
const fullTitle = `${title} — RateKit`;

const ldGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'RateKit', item: 'https://ratekit.org/' },
        { '@type': 'ListItem', position: 2, name: breadcrumbLabel, item: canonical },
      ],
    },
  ],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/favicon-180x180.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">

<meta property="og:type" content="website">
<meta property="og:url" content={canonical}>
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description}>
<meta property="og:image" content="https://ratekit.org/og-image.png">
<meta property="og:site_name" content="RateKit — Business Calculators">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={fullTitle}>
<meta name="twitter:description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="robots" content="index, follow, max-image-preview:large">
<meta property="og:locale" content="en_US">

<script type="application/ld+json" set:html={JSON.stringify(ldGraph)} />

<script async src="https://www.googletagmanager.com/gtag/js?id=G-JZZPXY8N1E"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-JZZPXY8N1E');
</script>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7303101907130018" crossorigin="anonymous"></script>

<style>
.page-header{position:relative;background:var(--white);border-bottom:1px solid var(--border-soft);padding:48px 48px 40px;overflow:hidden;}
.page-header::before{content:'';position:absolute;top:-120px;right:-80px;width:360px;height:360px;background:radial-gradient(circle,rgba(55,86,249,.08),rgba(123,92,250,.05) 55%,transparent 72%);pointer-events:none;}
.breadcrumb{position:relative;display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted);margin-bottom:18px;}
.breadcrumb a{color:var(--blue);}
.page-tag{position:relative;display:inline-flex;align-items:center;font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--blue);background:var(--bluebg);padding:5px 12px;border-radius:99px;margin-bottom:14px;}
h1{position:relative;font-size:clamp(1.65rem,3.5vw,2.5rem);font-weight:700;letter-spacing:-.025em;line-height:1.12;margin-bottom:10px;}
.page-sub{position:relative;font-size:15px;color:var(--mid);max-width:620px;}
main{padding:40px 48px 72px;max-width:760px;margin:0 auto;}
main :global(h2){font-size:1.2rem;font-weight:700;color:var(--ink);letter-spacing:-.01em;margin:36px 0 12px;}
main :global(h2:first-child){margin-top:0;}
main :global(h3){font-size:1rem;font-weight:700;color:var(--ink);margin:22px 0 8px;}
main :global(p){font-size:14.5px;color:var(--mid);line-height:1.8;margin-bottom:14px;}
main :global(ul),main :global(ol){padding-left:20px;margin-bottom:14px;}
main :global(li){font-size:14.5px;color:var(--mid);line-height:1.8;margin-bottom:6px;}
main :global(a){color:var(--blue);text-decoration:none;}
main :global(a:hover){text-decoration:underline;}
main :global(.last-updated){font-size:12px;color:var(--muted);margin-bottom:24px;}
main :global(.highlight-box){background:var(--bluebg);border:1px solid rgba(55,86,249,.15);border-radius:var(--radius);padding:18px 22px;margin-bottom:24px;font-size:14px;color:var(--mid);line-height:1.75;}
main :global(.highlight-box strong){color:var(--blue);}
main :global(table){width:100%;border-collapse:collapse;font-size:13px;margin-bottom:18px;border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;}
main :global(th){text-align:left;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);padding:10px 14px;background:var(--bg);border-bottom:1px solid var(--border);}
main :global(td){padding:10px 14px;border-bottom:1px solid var(--border);color:var(--mid);}
main :global(tr:last-child td){border-bottom:none;}
@media(max-width:768px){.page-header,main{padding-left:20px;padding-right:20px;}}
</style>
</head>
<body>
<Nav lang="en" altLangPath="/ru" />

<div class="page-header">
  <div class="breadcrumb"><a href="/">RateKit</a> › {breadcrumbLabel}</div>
  <div class="page-tag">{pageTag}</div>
  <h1>{h1}</h1>
  <p class="page-sub">{pageSub}</p>
</div>

<main>
  <slot />
</main>

<Footer lang="en" />
</body>
</html>

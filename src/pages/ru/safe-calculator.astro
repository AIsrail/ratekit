---
import ToolLayout from '../../layouts/ToolLayout.astro';

const faq = [
  { q: 'В чём разница между pre-money и post-money SAFE?',
    a: 'В post-money SAFE cap уже включает все деньги по SAFE, поэтому доля владения каждого инвестора фиксирована, а фаундеры несут размытие от последующих SAFE. В более старых pre-money SAFE держатели SAFE размывали друг друга.' },
  { q: 'Насколько сильно SAFE размывают фаундеров?',
    a: 'Сложите инвестиции / post-money cap по каждому SAFE. Привлечение $1M через SAFE при post-money cap $10M даёт около 10% размытия ещё до раунда с оценкой.' },
  { q: 'У SAFE бывает дисконт?',
    a: 'У некоторых — да. Стандартные формы предлагают cap, дисконт (часто 10–25%), оба условия сразу или ни одного (только MFN). Инвестор получает то условие, которое даёт более низкую цену конвертации.' },
];

const related = [
  { label: 'Burn Rate & Runway Calculator', path: '/burn-rate' },
  { label: 'LTV : CAC Calculator', path: '/ltv-cac' },
  { label: 'Deal Coach', path: '/deal-coach' },
  { label: 'Калькулятор ROI', path: '/ru/roi-calculator' },
  { label: 'Глоссарий: SAFE Note', path: '/ru/glossary/safe-note' },
  { label: 'Глоссарий: Размытие доли', path: '/ru/glossary/equity-dilution' },
];
---
<ToolLayout
  slug="safe-calculator"
  lang="ru"
  title="Калькулятор конвертации SAFE"
  description="Рассчитайте конвертацию вашего SAFE, долю владения и размытие. Поддерживает cap и дисконт. Бесплатный инструмент для фаундеров и инвесторов."
  pageTag="🚀 Инструмент для стартапов"
  h1="Калькулятор конвертации SAFE"
  pageSub="Смоделируйте конвертацию SAFE и увидите точно, какую долю получит инвестор. Поддерживает post-money SAFE (стандарт YC), cap и дисконт."
  dateModified="2026-10-18"
  guideTitle="Как SAFE конвертируются в долю"
  faq={faq}
  related={related}
>
  <style>
    .table-panel tbody td:first-child { font-weight: 600; color: var(--ink); }
  </style>

  <div class="info-box">
    <strong>Что такое SAFE?</strong> SAFE (Simple Agreement for Future Equity) — инструмент привлечения инвестиций для стартапов, созданный Y Combinator. Инвестор даёт деньги сейчас в обмен на долю при следующем раунде с оценкой, со скидкой или по фиксированному потолку оценки. Этот калькулятор использует модель <strong>post-money SAFE</strong> (стандарт YC с 2018 года).
  </div>

  <div class="grid-2">
    <div class="panel">
      <div class="panel-title">Условия SAFE</div>
      <div class="field">
        <label class="lbl">Тип SAFE</label>
        <div class="mode-toggle">
          <button class="mode-btn active" id="type-cap-btn">Cap</button>
          <button class="mode-btn" id="type-discount-btn">Только дисконт</button>
          <button class="mode-btn" id="type-both-btn">Cap + дисконт</button>
        </div>
      </div>
      <div class="field"><label class="lbl">Сумма инвестиции</label><div class="input-wrap"><span class="ifix">$</span><input type="number" id="investment" value="250000" min="0"></div></div>
      <div class="field" id="cap-field"><label class="lbl">Cap <span class="hint">(post-money)</span></label><div class="input-wrap"><span class="ifix">$</span><input type="number" id="valcap" value="5000000" min="0"></div></div>
      <div class="field" id="discount-field" style="display:none;"><label class="lbl">Дисконт <span class="hint">(от цены следующего раунда)</span></label><div class="input-wrap"><input type="number" id="discount" value="20" min="0" max="50"><span class="ifix ifix-r">%</span></div></div>
    </div>
    <div class="panel">
      <div class="panel-title">Следующий раунд с оценкой</div>
      <div class="field"><label class="lbl">Pre-money оценка</label><div class="input-wrap"><span class="ifix">$</span><input type="number" id="premoney" value="10000000" min="0"></div></div>
      <div class="field"><label class="lbl">Новые инвестиции в раунде</label><div class="input-wrap"><span class="ifix">$</span><input type="number" id="newround" value="2000000" min="0"></div></div>
      <div class="field"><label class="lbl">Существующие акции (до раунда)</label><div class="input-wrap"><input type="number" id="shares" value="10000000" min="1"><span class="ifix ifix-r">акций</span></div></div>
      <div class="field"><label class="lbl">Опционный пул (новый) <span class="hint">(добавляется до раунда)</span></label><div class="input-wrap"><input type="number" id="optpool" value="10" min="0" max="30"><span class="ifix ifix-r">%</span></div></div>
    </div>
  </div>

  <div class="results-row">
    <div class="r-card highlight"><div class="r-label">Доля инвестора</div><div class="r-value" id="r-ownership">—</div><div class="r-sub">при конвертации</div></div>
    <div class="r-card"><div class="r-label">Цена за акцию</div><div class="r-value" id="r-price">—</div><div class="r-sub">цена конвертации SAFE</div></div>
    <div class="r-card"><div class="r-label">Акций выпущено</div><div class="r-value" id="r-shares">—</div><div class="r-sub">инвестору по SAFE</div></div>
    <div class="r-card"><div class="r-label">Размытие фаундеров</div><div class="r-value" id="r-dilution">—</div><div class="r-sub">от этого SAFE</div></div>
  </div>

  <div class="table-panel">
    <div class="table-title">Cap table после конвертации</div>
    <table>
      <thead><tr><th>Сторона</th><th>Акций</th><th>Доля %</th><th>Стоимость (по цене раунда)</th></tr></thead>
      <tbody id="captable">
        <tr><td colspan="4" style="text-align:center;color:var(--muted);padding:20px;">Введите значения выше, чтобы увидеть cap table</td></tr>
      </tbody>
    </table>
  </div>

  <div class="warn-box">
    <strong>⚠️ Дисклеймер:</strong> Этот калькулятор носит иллюстративный характер и использует упрощённые допущения. Реальные конвертации SAFE могут включать pro-rata права, оговорки MFN, side letters и другие условия. Перед подписанием любых юридических документов проконсультируйтесь со стартап-юристом.
  </div>

  <div style="background:var(--ink);border-radius:12px;padding:24px 28px;margin-bottom:20px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;">
    <div>
      <div style="font-size:14px;font-weight:700;color:white;margin-bottom:4px;">🤖 Нужна помощь в переговорах об условиях SAFE?</div>
      <div style="font-size:12px;color:rgba(255,255,255,.45);">AI-коуч по переговорам — структурированные аргументы для обсуждения доли</div>
    </div>
    <a href="/deal-coach" style="padding:10px 20px;background:var(--blue);color:white;border-radius:8px;font-family:var(--font);font-size:13px;font-weight:600;text-decoration:none;white-space:nowrap;">Открыть Deal Coach →</a>
  </div>

  <Fragment slot="guide">
    <p>SAFE (Simple Agreement for Future Equity) конвертируется в акции при следующем раунде с оценкой. Post-money SAFE, стандартная форма Y Combinator, фиксирует долю инвестора заранее: инвестиция, делённая на post-money cap.</p>
    <h3>Формула</h3>
    <pre>Доля (post-money SAFE) = Инвестиция / Post-money cap
Цена конвертации = минимум из (цена по cap, цена раунда x (1 - Дисконт))</pre>
    <h3>Пример</h3>
    <p>$500 000 при post-money cap $10M = около 5% доли ещё до раунда с оценкой. Если цена за акцию в раунде ниже цены по cap, инвестор конвертируется по цене раунда (или со скидкой, если применяется дисконт).</p>
  </Fragment>

  <script>
    let safeType = 'cap';

    function setType(t) {
      safeType = t;
      document.getElementById('type-cap-btn').classList.toggle('active', t === 'cap');
      document.getElementById('type-discount-btn').classList.toggle('active', t === 'discount');
      document.getElementById('type-both-btn').classList.toggle('active', t === 'both');
      document.getElementById('cap-field').style.display = (t === 'discount') ? 'none' : 'block';
      document.getElementById('discount-field').style.display = (t === 'cap') ? 'none' : 'block';
      calc();
    }
    document.getElementById('type-cap-btn').addEventListener('click', () => setType('cap'));
    document.getElementById('type-discount-btn').addEventListener('click', () => setType('discount'));
    document.getElementById('type-both-btn').addEventListener('click', () => setType('both'));

    function fmtNum(n) { return n >= 1000000 ? (n / 1000000).toFixed(2) + 'M' : n >= 1000 ? (n / 1000).toFixed(1) + 'K' : Math.round(n).toLocaleString('ru-RU'); }
    function fmtPct(n) { return n.toFixed(2) + '%'; }
    function fmtUSD(n) { return '$' + Math.round(n).toLocaleString('ru-RU'); }

    function calc() {
      const inv = +document.getElementById('investment').value || 0;
      const cap = +document.getElementById('valcap').value || 0;
      const disc = +document.getElementById('discount').value || 0;
      const pre = +document.getElementById('premoney').value || 1;
      const newRound = +document.getElementById('newround').value || 0;
      const existShares = +document.getElementById('shares').value || 1;
      const optPool = +document.getElementById('optpool').value || 0;

      const postMoney = pre + newRound;

      const optPoolShares = Math.round(existShares * optPool / (100 - optPool));
      const totalPreShares = existShares + optPoolShares;

      const roundPricePerShare = pre / totalPreShares;

      let conversionPrice;
      if (safeType === 'cap') {
        conversionPrice = cap / totalPreShares;
      } else if (safeType === 'discount') {
        conversionPrice = roundPricePerShare * (1 - disc / 100);
      } else {
        const capPrice = cap / totalPreShares;
        const discPrice = roundPricePerShare * (1 - disc / 100);
        conversionPrice = Math.min(capPrice, discPrice);
      }

      const safeShares = conversionPrice > 0 ? Math.round(inv / conversionPrice) : 0;
      const newRoundShares = roundPricePerShare > 0 ? Math.round(newRound / roundPricePerShare) : 0;
      const totalShares = totalPreShares + safeShares + newRoundShares;

      const ownershipPct = totalShares > 0 ? (safeShares / totalShares * 100) : 0;
      const founderDilution = totalShares > 0 ? (safeShares / totalShares * 100) : 0;

      document.getElementById('r-ownership').textContent = fmtPct(ownershipPct);
      document.getElementById('r-price').textContent = conversionPrice > 0 ? '$' + conversionPrice.toFixed(4) : '—';
      document.getElementById('r-shares').textContent = fmtNum(safeShares);
      document.getElementById('r-dilution').textContent = fmtPct(founderDilution);

      const founderPct = existShares / totalShares * 100;
      const optPct = optPoolShares / totalShares * 100;
      const newInvPct = newRoundShares / totalShares * 100;

      document.getElementById('captable').innerHTML = `
        <tr><td>Фаундеры</td><td class="mono">${fmtNum(existShares)}</td><td class="mono">${fmtPct(founderPct)}</td><td class="mono">${fmtUSD(existShares * roundPricePerShare)}</td></tr>
        <tr><td>Опционный пул</td><td class="mono">${fmtNum(optPoolShares)}</td><td class="mono">${fmtPct(optPct)}</td><td class="mono">${fmtUSD(optPoolShares * roundPricePerShare)}</td></tr>
        <tr><td>Инвестор по SAFE</td><td class="mono">${fmtNum(safeShares)}</td><td class="mono">${fmtPct(ownershipPct)}</td><td class="mono">${fmtUSD(safeShares * roundPricePerShare)}</td></tr>
        <tr><td>Новые инвесторы раунда</td><td class="mono">${fmtNum(newRoundShares)}</td><td class="mono">${fmtPct(newInvPct)}</td><td class="mono">${fmtUSD(newRound)}</td></tr>
        <tr class="total"><td>Итого</td><td class="mono">${fmtNum(totalShares)}</td><td class="mono">100.00%</td><td class="mono">${fmtUSD(postMoney)}</td></tr>
      `;
    }

    document.addEventListener('input', calc);
    document.addEventListener('rk:restored', calc);
    window.addEventListener('load', calc);
  </script>
</ToolLayout>

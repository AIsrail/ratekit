---
import ToolLayout from '../layouts/ToolLayout.astro';

const faq = [
  { q: 'What costs are fixed and which are variable?',
    a: "Fixed costs don't change with sales volume (rent, salaries, software). Variable costs grow with each unit sold (materials, payment fees, shipping, commissions)." },
  { q: 'How can I lower my break-even point?',
    a: 'Raise prices, cut variable costs per unit, or reduce fixed costs. Raising price usually has the biggest effect because it goes straight to contribution margin.' },
  { q: 'What is the margin of safety?',
    a: 'How far current sales are above break-even: (Actual sales - Break-even sales) / Actual sales. It shows how much sales can drop before you start losing money.' },
];

const related = [
  { label: 'Profit Margin Calculator', path: '/profit-margin' },
  { label: 'Burn Rate & Runway Calculator', path: '/burn-rate' },
  { label: 'Profit & Loss Statement', path: '/pl-statement' },
  { label: 'ROI Calculator', path: '/roi-calculator' },
  { label: 'Glossary: Break-Even Point', path: '/glossary/break-even-point' },
  { label: 'Glossary: Contribution Margin', path: '/glossary/contribution-margin' },
];
---
<ToolLayout
  slug="break-even"
  lang="en"
  title="Break-even Calculator"
  description="Calculate your break-even point in units and revenue. Find out how many sales you need to cover fixed and variable costs. Free tool for businesses and startups."
  pageTag="⚖️ Business Tool"
  pageTagColor="var(--amber)"
  h1="Break-even Calculator"
  pageSub="Find out exactly how many units you need to sell — or revenue you need to generate — to cover all costs and start making a profit."
  dateModified="2026-10-13"
  guideTitle="How to calculate your break-even point"
  faq={faq}
  related={related}
>
  <div class="grid-2">
    <div class="panel">
      <div class="panel-title">Fixed Costs <span style="font-weight:400;color:var(--muted);font-size:10px;">(monthly, don't change with volume)</span></div>
      <div class="field"><label class="lbl">Rent / Office</label><div class="input-wrap"><span class="ifix">$</span><input type="number" id="rent" value="3000" min="0"></div></div>
      <div class="field"><label class="lbl">Salaries & Payroll</label><div class="input-wrap"><span class="ifix">$</span><input type="number" id="salaries" value="15000" min="0"></div></div>
      <div class="field"><label class="lbl">Software & Tools</label><div class="input-wrap"><span class="ifix">$</span><input type="number" id="software" value="1000" min="0"></div></div>
      <div class="field"><label class="lbl">Marketing & Ads</label><div class="input-wrap"><span class="ifix">$</span><input type="number" id="marketing" value="3000" min="0"></div></div>
      <div class="field"><label class="lbl">Other Fixed Costs</label><div class="input-wrap"><span class="ifix">$</span><input type="number" id="other" value="1000" min="0"></div></div>
    </div>
    <div class="panel">
      <div class="panel-title">Pricing & Variable Costs</div>
      <div class="field"><label class="lbl">Price per Unit / Sale</label><div class="input-wrap"><span class="ifix">$</span><input type="number" id="price" value="99" min="0.01" step="0.01"></div></div>
      <div class="field"><label class="lbl">Variable Cost per Unit <span class="hint">(COGS, delivery...)</span></label><div class="input-wrap"><span class="ifix">$</span><input type="number" id="vcost" value="30" min="0" step="0.01"></div></div>
      <div class="field"><label class="lbl">Current Monthly Units Sold</label><div class="input-wrap"><input type="number" id="units" value="100" min="0"><span class="ifix ifix-r">units</span></div></div>
      <div class="field"><label class="lbl">Profit Target <span class="hint">(optional goal)</span></label><div class="input-wrap"><span class="ifix">$</span><input type="number" id="target" value="5000" min="0"></div></div>
    </div>
  </div>

  <div class="results-row">
    <div class="r-card highlight"><div class="r-label">Break-even Units</div><div class="r-value" id="r-beunits">—</div><div class="r-sub">units per month</div></div>
    <div class="r-card"><div class="r-label">Break-even Revenue</div><div class="r-value" id="r-berev">—</div><div class="r-sub">monthly revenue needed</div></div>
    <div class="r-card"><div class="r-label">Contribution Margin</div><div class="r-value" id="r-cm">—</div><div class="r-sub" id="r-cm-sub">per unit</div></div>
    <div class="r-card"><div class="r-label">Current Profit/Loss</div><div class="r-value" id="r-profit">—</div><div class="r-sub" id="r-profit-sub">at current volume</div></div>
  </div>

  <div class="chart-panel">
    <div class="chart-title">Revenue vs. Costs Chart</div>
    <canvas id="beChart"></canvas>
  </div>

  <div class="table-panel">
    <div class="table-title">Scenario Analysis</div>
    <table>
      <thead><tr><th>Units Sold</th><th>Revenue</th><th>Variable Costs</th><th>Fixed Costs</th><th>Profit / Loss</th></tr></thead>
      <tbody id="scenario-table"></tbody>
    </table>
  </div>

  <div class="info-box">
    <strong>📐 Formula:</strong> Break-even Units = Fixed Costs / (Price − Variable Cost per Unit) &nbsp;·&nbsp; Contribution Margin = Price − Variable Cost &nbsp;·&nbsp; CM Ratio = CM / Price
  </div>

  <Fragment slot="guide">
    <p>The break-even point is the sales volume at which revenue exactly covers fixed and variable costs: no profit, no loss. Every unit sold after that adds its full contribution margin to profit.</p>
    <h3>Formula</h3>
    <pre>Contribution margin per unit = Price - Variable cost per unit
Break-even units = Fixed costs / Contribution margin per unit
Break-even revenue = Break-even units x Price</pre>
    <h3>Example</h3>
    <p>Fixed costs $10,000 per month, price $50, variable cost $30. Contribution margin = $20. Break-even = $10,000 / $20 = 500 units, or $25,000 in monthly revenue.</p>
  </Fragment>

  <script>
    function fmt(n) { return '$' + Math.round(Math.abs(n)).toLocaleString('en-US'); }

    function calc() {
      const rent = +document.getElementById('rent').value || 0;
      const sal = +document.getElementById('salaries').value || 0;
      const sw = +document.getElementById('software').value || 0;
      const mkt = +document.getElementById('marketing').value || 0;
      const other = +document.getElementById('other').value || 0;
      const price = +document.getElementById('price').value || 1;
      const vcost = +document.getElementById('vcost').value || 0;
      const units = +document.getElementById('units').value || 0;

      const fixedTotal = rent + sal + sw + mkt + other;
      const cm = price - vcost;
      const cmRatio = price > 0 ? cm / price : 0;
      const beUnits = cm > 0 ? Math.ceil(fixedTotal / cm) : Infinity;
      const beRev = beUnits * price;
      const currentRev = units * price;
      const currentVC = units * vcost;
      const profit = currentRev - currentVC - fixedTotal;

      document.getElementById('r-beunits').textContent = beUnits === Infinity ? '∞' : beUnits.toLocaleString();
      document.getElementById('r-berev').textContent = beUnits === Infinity ? '∞' : fmt(beRev);
      document.getElementById('r-cm').textContent = fmt(cm);
      document.getElementById('r-cm-sub').textContent = `CM ratio: ${(cmRatio * 100).toFixed(1)}%`;

      const profitEl = document.getElementById('r-profit');
      const profitCard = profitEl.closest('.r-card');
      profitEl.textContent = (profit >= 0 ? '+' : '-') + fmt(profit);
      profitCard.style.background = profit >= 0 ? 'var(--greenbg)' : 'var(--redbg)';
      profitCard.style.borderColor = profit >= 0 ? '#6EE7B7' : '#FECACA';
      profitEl.style.color = profit >= 0 ? 'var(--green)' : 'var(--red)';
      document.getElementById('r-profit-sub').textContent = profit >= 0 ? '✅ Profitable' : '🚨 Loss';

      const maxUnits = Math.max(beUnits * 2, units * 2, 200);
      const step = Math.max(1, Math.round(maxUnits / 8));
      let rows = '';
      for (let u = 0; u <= maxUnits; u += step) {
        const rev = u * price;
        const vc = u * vcost;
        const p = rev - vc - fixedTotal;
        const isBreakeven = u >= beUnits && (u - step) < beUnits;
        rows += `<tr${isBreakeven ? ' class="breakeven-row"' : ''}>
          <td class="mono">${u.toLocaleString()}${isBreakeven ? ' ⚖️' : ''}</td>
          <td class="mono">$${Math.round(rev).toLocaleString()}</td>
          <td class="mono">$${Math.round(vc).toLocaleString()}</td>
          <td class="mono">$${Math.round(fixedTotal).toLocaleString()}</td>
          <td class="mono ${p >= 0 ? 'profit' : 'loss'}">${p >= 0 ? '+' : '-'}$${Math.round(Math.abs(p)).toLocaleString()}</td>
        </tr>`;
      }
      document.getElementById('scenario-table').innerHTML = rows;

      drawChart(fixedTotal, cm, beUnits, units, price, vcost);
    }

    function drawChart(fixed, cm, beUnits, currentUnits, price, vcost) {
      const canvas = document.getElementById('beChart');
      const ctx = canvas.getContext('2d');
      const W = canvas.offsetWidth || 600;
      const H = 220;
      canvas.width = W; canvas.height = H;
      ctx.clearRect(0, 0, W, H);

      const maxU = Math.max(beUnits * 1.8, currentUnits * 1.5, 10);
      const maxRev = maxU * price;
      const pad = { l: 60, r: 20, t: 20, b: 40 };
      const cw = W - pad.l - pad.r;
      const ch = H - pad.t - pad.b;

      function xp(u) { return pad.l + (u / maxU) * cw; }
      function yp(v) { return pad.t + ch - (v / maxRev) * ch; }

      ctx.strokeStyle = '#E2E8F0'; ctx.lineWidth = 1;
      for (let i = 0; i <= 4; i++) {
        const y = pad.t + (ch / 4) * i;
        ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(pad.l + cw, y); ctx.stroke();
        const val = Math.round(maxRev * (1 - i / 4));
        ctx.fillStyle = '#94A3B8'; ctx.font = '10px Plus Jakarta Sans'; ctx.textAlign = 'right';
        ctx.fillText('$' + Math.round(val / 1000) + 'K', pad.l - 6, y + 4);
      }

      ctx.strokeStyle = '#DC2626'; ctx.lineWidth = 2; ctx.setLineDash([4, 4]);
      ctx.beginPath(); ctx.moveTo(pad.l, yp(fixed)); ctx.lineTo(pad.l + cw, yp(fixed)); ctx.stroke();
      ctx.setLineDash([]);

      ctx.strokeStyle = '#F97316'; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(xp(0), yp(fixed)); ctx.lineTo(xp(maxU), yp(fixed + maxU * Math.abs(price - cm))); ctx.stroke();

      ctx.strokeStyle = '#2563EB'; ctx.lineWidth = 2.5;
      ctx.beginPath(); ctx.moveTo(xp(0), yp(0)); ctx.lineTo(xp(maxU), yp(maxU * price)); ctx.stroke();

      if (beUnits < maxU) {
        const bx = xp(beUnits); const by = yp(beUnits * price);
        ctx.fillStyle = '#059669'; ctx.beginPath(); ctx.arc(bx, by, 6, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = '#059669'; ctx.font = 'bold 11px Plus Jakarta Sans'; ctx.textAlign = 'center';
        ctx.fillText('Break-even', bx, by - 12);
      }

      ctx.font = '11px Plus Jakarta Sans'; ctx.textAlign = 'left';
      [['#2563EB', 'Revenue'], ['#F97316', 'Total Cost'], ['#DC2626', 'Fixed Cost']].forEach(([c, l], i) => {
        ctx.fillStyle = c; ctx.fillRect(pad.l + i * 110, H - 14, 12, 3);
        ctx.fillStyle = '#475569'; ctx.fillText(l, pad.l + i * 110 + 16, H - 10);
      });
    }

    document.addEventListener('input', calc);
    document.addEventListener('rk:restored', calc);
    window.addEventListener('load', calc);
    window.addEventListener('resize', calc);
  </script>
</ToolLayout>

---
import ToolLayout from '../layouts/ToolLayout.astro';

const faq = [
  { q: 'What is the difference between gross and net burn?',
    a: 'Gross burn is total monthly spending. Net burn subtracts revenue and shows how fast your cash balance actually falls.' },
  { q: 'How much runway should a startup have?',
    a: 'Commonly 18-24 months after a raise. Start fundraising with at least 6-9 months left, since rounds often take 3-6 months to close.' },
  { q: 'How can I extend runway?',
    a: 'Cut or delay the biggest expense lines (usually hiring), increase revenue or collections, renegotiate contracts, or raise bridge funding.' },
];

const related = [
  { label: 'SAFE Note Equity Calculator', path: '/safe-calculator' },
  { label: 'LTV : CAC Calculator', path: '/ltv-cac' },
  { label: 'Break-even Calculator', path: '/break-even' },
  { label: 'Profit & Loss Statement', path: '/pl-statement' },
];
---
<ToolLayout
  slug="burn-rate"
  lang="en"
  title="Burn Rate & Runway Calculator"
  description="Calculate your startup's gross and net burn rate, cash runway in months, and zero-cash date. Free tool for founders and CFOs."
  pageTag="🔥 Startup Tool"
  pageTagColor="var(--red)"
  h1="Burn Rate & Runway Calculator"
  pageSub="Find out how long your startup can survive on current cash. Calculate gross and net burn rate, runway in months, and your zero-cash date."
  dateModified="2026-10-13"
  guideTitle="How to calculate burn rate and runway"
  faq={faq}
  related={related}
>
  <div class="grid-2">
    <div class="panel">
      <div class="panel-title">Cash Position</div>
      <div class="field"><label class="lbl">Cash in Bank <span class="hint">(current balance)</span></label><div class="input-wrap"><span class="ifix">$</span><input type="number" id="cash" value="500000" min="0"></div></div>
      <div class="field"><label class="lbl">Start Date</label><div class="input-wrap"><input type="date" id="startdate"></div></div>
      <div class="field"><label class="lbl">Fundraising Target <span class="hint">(optional, next round)</span></label><div class="input-wrap"><span class="ifix">$</span><input type="number" id="target" value="0" min="0"></div></div>
    </div>
    <div class="panel">
      <div class="panel-title">Monthly Financials</div>
      <div class="field"><label class="lbl">Gross Burn <span class="hint">(total monthly expenses)</span></label><div class="input-wrap"><span class="ifix">$</span><input type="number" id="grossburn" value="50000" min="0"></div></div>
      <div class="field"><label class="lbl">Monthly Revenue <span class="hint">(MRR / monthly income)</span></label><div class="input-wrap"><span class="ifix">$</span><input type="number" id="revenue" value="10000" min="0"></div></div>
      <div class="field"><label class="lbl">Monthly Revenue Growth <span class="hint">(optional)</span></label><div class="input-wrap"><input type="number" id="growth" value="0" min="0" max="100"><span class="ifix ifix-r">%/mo</span></div></div>
    </div>
  </div>

  <div class="results-row">
    <div class="r-card red" id="card-burn"><div class="r-label">Net Burn Rate</div><div class="r-value" id="r-netburn">—</div><div class="r-sub">per month</div></div>
    <div class="r-card amber" id="card-gross"><div class="r-label">Gross Burn</div><div class="r-value" id="r-grossburn">—</div><div class="r-sub">total monthly spend</div></div>
    <div class="r-card green" id="card-runway"><div class="r-label">Runway</div><div class="r-value" id="r-runway">—</div><div class="r-sub" id="r-runway-sub">months</div></div>
    <div class="r-card" id="card-date"><div class="r-label">Zero-Cash Date</div><div class="r-value" id="r-date" style="font-size:1.1rem;">—</div><div class="r-sub">estimated</div></div>
  </div>

  <div class="runway-panel">
    <div class="panel-title">Cash Runway Visualization</div>
    <div class="rw-bar-wrap">
      <div class="rw-bar-track"><div class="rw-bar-fill" id="rw-bar" style="width:0%;background:var(--green);"></div></div>
      <div class="rw-labels"><span>Now</span><span>Zero cash</span></div>
    </div>
  </div>

  <div class="table-panel">
    <div class="table-title">Monthly Cash Projection</div>
    <table>
      <thead><tr><th>Month</th><th>Revenue</th><th>Burn</th><th>Net</th><th>Cash Balance</th></tr></thead>
      <tbody id="proj-table"></tbody>
    </table>
  </div>

  <div class="info-box">
    <strong>💡 Rule of thumb:</strong> VCs typically want to see <strong>18+ months of runway</strong> before investing. If you have less than 6 months, you should be fundraising now. Net burn = Gross burn − Revenue.
  </div>

  <Fragment slot="guide">
    <p>Burn rate is how much cash a company loses per month; runway is how many months it can survive at that pace. Investors look at net burn (after revenue), and founders are usually advised to start raising with at least 6-9 months of runway left.</p>
    <h3>Formula</h3>
    <pre>Gross burn = Total monthly operating expenses
Net burn = Monthly expenses - Monthly revenue
Runway (months) = Cash in bank / Net burn</pre>
    <h3>Example</h3>
    <p>$600,000 in the bank, $80,000 monthly expenses, $30,000 monthly revenue. Net burn = $50,000 per month; runway = 12 months.</p>
  </Fragment>

  <script>
    function fmt(n) { return '$' + Math.round(Math.abs(n)).toLocaleString('en-US'); }
    function fmtSigned(n) { return (n >= 0 ? '+' : '-') + '$' + Math.round(Math.abs(n)).toLocaleString(); }

    document.getElementById('startdate').value = new Date().toISOString().split('T')[0];

    function calc() {
      const cash = +document.getElementById('cash').value || 0;
      const grossBurn = +document.getElementById('grossburn').value || 0;
      const rev = +document.getElementById('revenue').value || 0;
      const growth = +document.getElementById('growth').value || 0;
      const startDate = new Date(document.getElementById('startdate').value || Date.now());

      const netBurn = grossBurn - rev;
      document.getElementById('r-netburn').textContent = fmt(netBurn) + '/mo';
      document.getElementById('r-grossburn').textContent = fmt(grossBurn) + '/mo';

      const burnCard = document.getElementById('card-burn');
      burnCard.className = 'r-card ' + (netBurn <= 0 ? 'green' : netBurn > grossBurn * 0.8 ? 'red' : 'amber');

      let balance = cash;
      let monthlyRev = rev;
      const rows = [];

      for (let i = 1; i <= 60; i++) {
        const net = grossBurn - monthlyRev;
        balance -= net;
        const d = new Date(startDate);
        d.setMonth(d.getMonth() + i);
        rows.push({
          month: d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' }),
          rev: monthlyRev, burn: grossBurn, net, balance,
        });
        if (balance <= 0) break;
        monthlyRev *= (1 + growth / 100);
      }

      const runway = rows.filter((r) => r.balance > 0).length;
      document.getElementById('r-runway').textContent = runway + ' mo';
      document.getElementById('r-runway-sub').textContent = runway >= 18 ? '✅ Healthy' : runway >= 6 ? '⚠️ Raise soon' : '🚨 Critical';

      const zeroDate = rows.find((r) => r.balance <= 0);
      if (zeroDate) {
        const zeroCashDate = new Date(startDate.getTime());
        zeroCashDate.setMonth(zeroCashDate.getMonth() + runway + 1);
        document.getElementById('r-date').textContent = zeroCashDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
      } else {
        document.getElementById('r-date').textContent = '60+ mo';
      }

      const pct = Math.min(100, runway / 24 * 100);
      const barColor = runway >= 18 ? 'var(--green)' : runway >= 6 ? 'var(--amber)' : 'var(--red)';
      document.getElementById('rw-bar').style.width = pct + '%';
      document.getElementById('rw-bar').style.background = barColor;

      const tableRows = rows.slice(0, 12).map((r) => `
        <tr>
          <td>${r.month}</td>
          <td class="mono">$${Math.round(r.rev).toLocaleString()}</td>
          <td class="mono">$${Math.round(r.burn).toLocaleString()}</td>
          <td class="mono ${r.net > 0 ? 'danger' : ''}">${fmtSigned(-r.net)}</td>
          <td class="mono ${r.balance < 0 ? 'danger' : ''}">$${Math.round(Math.max(0, r.balance)).toLocaleString()}</td>
        </tr>`).join('');
      document.getElementById('proj-table').innerHTML = tableRows;
    }

    document.addEventListener('input', calc);
    document.addEventListener('rk:restored', calc);
    window.addEventListener('load', calc);
  </script>
</ToolLayout>

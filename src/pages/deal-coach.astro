---
import ToolLayout from '../layouts/ToolLayout.astro';

const faq = [
  { q: 'What is BATNA?',
    a: 'Best Alternative To a Negotiated Agreement: what you will do if this deal fails. A strong BATNA gives you leverage and sets your walk-away point.' },
  { q: 'Should I make the first offer?',
    a: 'Often yes, if you have done your research: the first number anchors the negotiation. Open ambitiously but justifiably.' },
  { q: 'How do I negotiate without lowering my price?',
    a: 'Trade variables instead of discounts: scope, timeline, payment terms, volume or contract length.' },
];

const related = [
  { label: 'Freelance Rate Calculator', path: '/freelance-rate' },
  { label: 'SAFE Note Equity Calculator', path: '/safe-calculator' },
  { label: 'Profit Margin Calculator', path: '/profit-margin' },
  { label: 'ROI Calculator', path: '/roi-calculator' },
];
---
<ToolLayout
  slug="deal-coach"
  lang="en"
  title="Deal Coach — AI Negotiation Assistant"
  description="AI-powered negotiation coach for freelancers and founders. Get structured arguments for rate negotiation and equity/SAFE discussions. Free tool by RateKit."
  pageTag="🤖 AI-Powered"
  h1="Deal Coach"
  pageSub="AI negotiation assistant. Get structured arguments for your rate negotiation or equity discussion — in minutes."
  dateModified="2026-10-13"
  guideTitle="How to prepare for a business negotiation"
  faq={faq}
  related={related}
  ogType="website"
>
  <style is:global>
    main { max-width: 800px !important; margin: 0 auto; }
    .mode-select { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 32px; }
    .mode-card { background: var(--white); border: 2px solid var(--border); border-radius: 12px; padding: 24px; cursor: pointer; transition: all .2s; text-align: center; }
    .mode-card:hover { border-color: var(--blue); box-shadow: 0 4px 20px rgba(37,99,235,.08); }
    .mode-card.selected { border-color: var(--blue); background: var(--bluebg); }
    .mode-icon { font-size: 32px; margin-bottom: 12px; }
    .mode-title { font-size: 15px; font-weight: 700; color: var(--ink); margin-bottom: 6px; }
    .mode-desc { font-size: 12px; color: var(--muted); line-height: 1.5; }
    .api-section { background: var(--white); border: 1px solid var(--border); border-radius: 12px; padding: 20px; margin-bottom: 24px; }
    .api-row { display: flex; gap: 10px; align-items: center; }
    .api-input { flex: 1; background: var(--bg); border: 1.5px solid var(--border); border-radius: 8px; padding: 10px 14px; font-family: var(--mono); font-size: 13px; color: var(--ink); outline: none; transition: border-color .15s; }
    .api-input:focus { border-color: var(--blue); }
    .api-btn { padding: 10px 18px; background: var(--blue); color: white; border: none; border-radius: 8px; font-family: var(--font); font-size: 13px; font-weight: 600; cursor: pointer; white-space: nowrap; }
    .api-btn:hover { background: var(--blue2); }
    .api-hint { font-size: 11px; color: var(--muted); margin-top: 8px; }
    .api-hint a { color: var(--blue); }
    .chat-container { background: var(--white); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; margin-bottom: 20px; }
    .chat-header { background: var(--ink); color: white; padding: 16px 20px; display: flex; align-items: center; gap: 12px; }
    .chat-avatar { width: 36px; height: 36px; background: var(--blue); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; }
    .chat-title { font-size: 14px; font-weight: 600; }
    .chat-subtitle { font-size: 11px; color: rgba(255,255,255,.5); margin-top: 2px; }
    .chat-messages { padding: 20px; min-height: 300px; max-height: 500px; overflow-y: auto; display: flex; flex-direction: column; gap: 16px; }
    .msg { display: flex; gap: 12px; align-items: flex-start; }
    .msg.user { flex-direction: row-reverse; }
    .msg-avatar { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0; }
    .msg.ai .msg-avatar { background: var(--blue); color: white; }
    .msg.user .msg-avatar { background: var(--ink); color: white; }
    .msg-bubble { max-width: 80%; padding: 12px 16px; border-radius: 12px; font-size: 14px; line-height: 1.65; }
    .msg.ai .msg-bubble { background: var(--bg); color: var(--ink); border: 1px solid var(--border); }
    .msg.user .msg-bubble { background: var(--blue); color: white; }
    .msg-bubble p { margin-bottom: 8px; }
    .msg-bubble p:last-child { margin-bottom: 0; }
    .msg-bubble strong { font-weight: 600; }
    .typing { display: flex; gap: 4px; padding: 8px 0; align-items: center; }
    .typing span { width: 6px; height: 6px; background: var(--muted); border-radius: 50%; animation: bounce .8s infinite; }
    .typing span:nth-child(2) { animation-delay: .15s; }
    .typing span:nth-child(3) { animation-delay: .3s; }
    @keyframes bounce { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-4px)} }
    .chat-input-area { padding: 16px 20px; border-top: 1px solid var(--border); display: flex; gap: 10px; }
    .chat-input { flex: 1; background: var(--bg); border: 1.5px solid var(--border); border-radius: 8px; padding: 10px 14px; font-family: var(--font); font-size: 14px; color: var(--ink); outline: none; resize: none; min-height: 44px; max-height: 120px; transition: border-color .15s; }
    .chat-input:focus { border-color: var(--blue); }
    .send-btn { padding: 10px 18px; background: var(--blue); color: white; border: none; border-radius: 8px; font-family: var(--font); font-size: 13px; font-weight: 600; cursor: pointer; flex-shrink: 0; transition: background .15s; }
    .send-btn:hover { background: var(--blue2); }
    .send-btn:disabled { background: var(--muted); cursor: not-allowed; }
    .quick-replies { padding: 0 20px 16px; display: flex; flex-wrap: wrap; gap: 8px; }
    .qr-btn { padding: 7px 14px; background: var(--white); border: 1.5px solid var(--border); border-radius: 99px; font-family: var(--font); font-size: 12px; font-weight: 500; color: var(--mid); cursor: pointer; transition: all .15s; }
    .qr-btn:hover { border-color: var(--blue); color: var(--blue); }
    .result-panel { background: var(--white); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; margin-bottom: 20px; display: none; }
    .result-header { background: var(--ink); color: white; padding: 20px 28px; }
    .result-title { font-size: 18px; font-weight: 700; margin-bottom: 4px; }
    .result-subtitle { font-size: 12px; color: rgba(255,255,255,.5); }
    .result-body { padding: 28px; }
    .result-section { margin-bottom: 24px; }
    .result-section-title { font-size: 10px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }
    .result-arg { background: var(--bg); border-left: 3px solid var(--blue); border-radius: 0 8px 8px 0; padding: 12px 16px; margin-bottom: 10px; font-size: 13px; color: var(--mid); line-height: 1.65; }
    .result-arg strong { color: var(--ink); display: block; margin-bottom: 4px; font-size: 14px; }
    .result-highlight { background: var(--greenbg); border: 1px solid #6EE7B7; border-radius: 10px; padding: 16px 20px; margin-bottom: 16px; font-size: 14px; color: var(--ink); font-weight: 500; }
    .result-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--border); }
    .result-btn { padding: 10px 20px; border-radius: 8px; font-family: var(--font); font-size: 13px; font-weight: 600; cursor: pointer; border: none; transition: all .15s; }
    .result-btn.primary { background: var(--blue); color: white; }
    .result-btn.secondary { background: var(--white); color: var(--mid); border: 1.5px solid var(--border); }
    .result-btn.secondary:hover { border-color: var(--blue); color: var(--blue); }
    .result-disclaimer { font-size: 11px; color: var(--muted); line-height: 1.6; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border); }
    .start-btn { width: 100%; padding: 14px; background: var(--blue); color: white; border: none; border-radius: 10px; font-family: var(--font); font-size: 15px; font-weight: 700; cursor: pointer; transition: background .15s; margin-top: 8px; }
    .start-btn:hover { background: var(--blue2); }
    .start-btn:disabled { background: var(--muted); cursor: not-allowed; }
    @media print {
      .chat-input-area, .quick-replies, .result-actions, .api-section, .mode-select, .start-btn, .info-box { display: none !important; }
      main { padding: 0; max-width: 100% !important; }
      .result-panel { display: block !important; border: none; }
    }
    @media (max-width: 768px) { .mode-select { grid-template-columns: 1fr; } }
  </style>

  <div id="step-mode">
    <div class="info-box">
      <strong>How it works:</strong> Answer a few quick questions about your situation. The AI builds a structured negotiation brief with your key arguments, market data, and talking points. Takes 2-3 minutes.
    </div>

    <h2 style="font-size:15px;font-weight:700;color:var(--ink);margin-bottom:16px;">What do you need help negotiating?</h2>
    <div class="mode-select">
      <div class="mode-card" id="mode-rate" data-mode="rate">
        <div class="mode-icon">💰</div>
        <div class="mode-title">Rate Negotiation</div>
        <div class="mode-desc">Help me justify my freelance or consulting rate to a client</div>
      </div>
      <div class="mode-card" id="mode-equity" data-mode="equity">
        <div class="mode-icon">📊</div>
        <div class="mode-title">Equity / SAFE</div>
        <div class="mode-desc">Help me negotiate equity, valuation, or SAFE terms as a founder or investor</div>
      </div>
    </div>

    <div class="api-section">
      <div style="font-size:13px;font-weight:700;color:var(--ink);margin-bottom:12px;">🔑 Connect to AI (one-time setup)</div>
      <div style="background:#FFFBEB;border:1px solid #FDE68A;border-radius:8px;padding:14px 16px;margin-bottom:16px;font-size:13px;color:var(--mid);line-height:1.7;">
        <strong style="color:var(--amber);">Why do I need an API key?</strong><br>
        Deal Coach uses Claude AI to generate your negotiation brief. To keep this tool free for everyone, each user connects their own Anthropic account. New accounts get <strong>$5 free credits</strong> — enough for hundreds of conversations.
        <br><br>
        <strong>🔒 Privacy guarantee:</strong> Your API key is stored <strong>only in your browser</strong> (localStorage). It is never sent to our servers, never logged, and never shared with anyone. You can delete it anytime by clearing your browser data. We have no access to it whatsoever.
      </div>
      <div style="font-size:12px;font-weight:600;color:var(--mid);margin-bottom:8px;letter-spacing:.04em;">HOW TO GET YOUR FREE KEY (2 minutes):</div>
      <ol style="font-size:12px;color:var(--mid);line-height:2;padding-left:18px;margin-bottom:14px;">
        <li>Go to <a href="https://console.anthropic.com" target="_blank" rel="noopener" style="color:var(--blue);">console.anthropic.com</a> → Sign up free</li>
        <li>Click <strong>API Keys</strong> → <strong>Create Key</strong></li>
        <li>Copy the key (starts with <code style="background:var(--bg);padding:1px 5px;border-radius:4px;font-family:var(--mono);">sk-ant-</code>)</li>
        <li>Paste it below and click Save</li>
      </ol>
      <div class="api-row">
        <input type="password" class="api-input" id="api-key" placeholder="sk-ant-api03-...">
        <button class="api-btn" id="save-key-btn">Save key</button>
      </div>
      <div class="api-hint" style="margin-top:10px;display:flex;align-items:center;gap:6px;">
        <span>🔒</span> Key stored in your browser only · Never sent to RateKit servers · <a href="/privacy" style="color:var(--blue);">Privacy Policy</a>
      </div>
    </div>

    <button class="start-btn" id="start-btn" disabled>Choose a mode to continue →</button>
  </div>

  <div id="step-chat" style="display:none;">
    <div class="chat-container">
      <div class="chat-header">
        <div class="chat-avatar">🤖</div>
        <div>
          <div class="chat-title" id="chat-title">Deal Coach</div>
          <div class="chat-subtitle" id="chat-subtitle">AI negotiation assistant</div>
        </div>
      </div>
      <div class="chat-messages" id="chat-messages"></div>
      <div class="quick-replies" id="quick-replies"></div>
      <div class="chat-input-area">
        <textarea class="chat-input" id="chat-input" placeholder="Type your answer..." rows="1"></textarea>
        <button class="send-btn" id="send-btn">Send →</button>
      </div>
    </div>
  </div>

  <div class="result-panel" id="result-panel">
    <div class="result-header">
      <div class="result-title" id="result-title">Your Negotiation Brief</div>
      <div class="result-subtitle">Generated by RateKit Deal Coach</div>
    </div>
    <div class="result-body" id="result-body"></div>
  </div>

  <Fragment slot="guide">
    <p>Good negotiations are prepared, not improvised. Know your walk-away point, the other side's likely priorities and at least two alternatives before you start. Deal Coach helps you structure that preparation and rehearse your arguments.</p>
    <h3>Formula</h3>
    <pre>Prepare: BATNA (best alternative) -&gt; Walk-away point -&gt; Target -&gt; Opening offer
ZOPA = overlap between your walk-away point and theirs</pre>
    <h3>Example</h3>
    <p>Selling a $20,000 project: your BATNA is another client at $15,000, so your walk-away is $15,000. Target $22,000 and open at $25,000 with a clear scope; trade concessions (timeline, payment terms) rather than cutting price.</p>
  </Fragment>

  <script>
    let selectedMode = null;
    let apiKey = localStorage.getItem('rk_claude_key') || '';
    let conversationHistory = [];

    const apiKeyInput = document.getElementById('api-key');
    if (apiKey) {
      apiKeyInput.value = apiKey;
      updateStartBtn();
    }

    document.getElementById('save-key-btn').addEventListener('click', () => {
      const key = apiKeyInput.value.trim();
      if (!key.startsWith('sk-ant')) {
        alert('Please enter a valid Anthropic API key (starts with sk-ant-)');
        return;
      }
      apiKey = key;
      localStorage.setItem('rk_claude_key', key);
      updateStartBtn();
      apiKeyInput.placeholder = '✅ Key saved';
    });

    document.querySelectorAll('.mode-card').forEach((card) => {
      card.addEventListener('click', () => {
        selectedMode = card.getAttribute('data-mode');
        document.querySelectorAll('.mode-card').forEach((c) => c.classList.remove('selected'));
        card.classList.add('selected');
        updateStartBtn();
      });
    });

    function updateStartBtn() {
      const btn = document.getElementById('start-btn');
      if (selectedMode && apiKey) {
        btn.disabled = false;
        btn.textContent = 'Start Deal Coach →';
      } else if (!selectedMode) {
        btn.textContent = 'Choose a mode to continue →';
        btn.disabled = true;
      } else {
        btn.textContent = 'Enter API key to continue →';
        btn.disabled = true;
      }
    }

    document.getElementById('start-btn').addEventListener('click', startCoach);

    function startCoach() {
      (document.getElementById('step-mode')).style.display = 'none';
      (document.getElementById('step-chat')).style.display = 'block';

      if (selectedMode === 'rate') {
        document.getElementById('chat-title').textContent = 'Rate Negotiation Coach';
        document.getElementById('chat-subtitle').textContent = 'Helping you justify your freelance rate';
      } else {
        document.getElementById('chat-title').textContent = 'Equity Negotiation Coach';
        document.getElementById('chat-subtitle').textContent = 'Helping you negotiate equity and SAFE terms';
      }

      conversationHistory = [];
      const firstMessage = selectedMode === 'rate'
        ? "Hi! I'm your Deal Coach. I'll help you build a strong case for your rate negotiation.\n\nFirst — **what is your current or target hourly rate**, and what's the client's pushback? (e.g. \"I charge $120/hr but the client says it's too high\")"
        : "Hi! I'm your Deal Coach. I'll help you prepare for your equity or SAFE negotiation.\n\nLet's start — **what's your situation?** Are you a founder negotiating with an investor, or an investor evaluating a startup's terms?";

      addMessage('ai', firstMessage);
      setQuickReplies(selectedMode === 'rate'
        ? ["Client says I'm too expensive", "Negotiating a raise with existing client", "Setting rate for a new client"]
        : ["Founder negotiating SAFE terms", "Investor evaluating a deal", "Co-founder equity split"]);
    }

    function getRateSystemPrompt() {
      return `You are Deal Coach, an expert negotiation assistant for freelancers and consultants on RateKit (ratekit.org).

Your job: through a SHORT conversational interview (4-6 questions max), gather key information, then generate a structured negotiation brief.

Ask about:
1. Their rate and client's objection
2. Their experience/expertise level and years
3. Their specialty/niche
4. The client's industry and company size
5. The value/ROI they deliver (optional)

After 4-6 exchanges, say "I have enough to build your brief" and call the function generate_brief with all context.

Style: friendly, direct, professional. Short questions. One question at a time. Never ask more than one question per message.

When generating the brief, format it as JSON with this structure:
{
  "summary": "One sentence summary of their situation",
  "opening_position": "How to open the negotiation",
  "key_arguments": [
    {"title": "...", "argument": "...", "how_to_say": "..."},
    ...3-5 arguments...
  ],
  "handle_objections": [
    {"objection": "...", "response": "..."},
    ...2-3 objections...
  ],
  "bottom_line": "Your absolute minimum and when to walk away",
  "closing_line": "A specific closing statement to use"
}

When you have enough info, respond with exactly: GENERATE_BRIEF followed by the JSON on the next line.`;
    }

    function getEquitySystemPrompt() {
      return `You are Deal Coach, an expert negotiation assistant for startup founders and investors on RateKit (ratekit.org).

Your job: through a SHORT conversational interview (4-6 questions max), gather key information about their equity or SAFE negotiation, then generate a structured brief.

For founders, ask about:
1. Their role (founder/investor/co-founder)
2. Stage of company (idea/MVP/revenue)
3. SAFE or priced round, valuation cap they're considering
4. What the investor is offering vs what they want
5. Key traction metrics if any

After 4-6 exchanges, generate the brief.

When generating the brief, format it as JSON:
{
  "summary": "One sentence summary",
  "opening_position": "How to open",
  "key_arguments": [
    {"title": "...", "argument": "...", "how_to_say": "..."},
    ...3-5 arguments...
  ],
  "handle_objections": [
    {"objection": "...", "response": "..."},
    ...2-3 objections...
  ],
  "bottom_line": "Your walk-away terms",
  "closing_line": "A specific closing statement"
}

When you have enough info, respond with exactly: GENERATE_BRIEF followed by the JSON on the next line.`;
    }

    function addMessage(role, text) {
      const container = document.getElementById('chat-messages');
      const div = document.createElement('div');
      div.className = 'msg ' + role;
      const avatar = role === 'ai' ? '🤖' : '👤';
      const formatted = text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/\n/g, '<br>');
      div.innerHTML = `<div class="msg-avatar">${avatar}</div><div class="msg-bubble">${formatted}</div>`;
      container.appendChild(div);
      container.scrollTop = container.scrollHeight;
    }

    function addTyping() {
      const container = document.getElementById('chat-messages');
      const div = document.createElement('div');
      div.className = 'msg ai';
      div.id = 'typing-indicator';
      div.innerHTML = `<div class="msg-avatar">🤖</div><div class="msg-bubble"><div class="typing"><span></span><span></span><span></span></div></div>`;
      container.appendChild(div);
      container.scrollTop = container.scrollHeight;
    }

    function removeTyping() {
      document.getElementById('typing-indicator')?.remove();
    }

    function setQuickReplies(options) {
      const container = document.getElementById('quick-replies');
      container.innerHTML = '';
      options.forEach((o) => {
        const btn = document.createElement('button');
        btn.className = 'qr-btn';
        btn.textContent = o;
        btn.addEventListener('click', () => useQuickReply(o));
        container.appendChild(btn);
      });
    }

    function useQuickReply(text) {
      (document.getElementById('chat-input')).value = text;
      sendMessage();
    }

    const chatInput = document.getElementById('chat-input');
    chatInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
      }
    });
    chatInput.addEventListener('input', () => {
      chatInput.style.height = 'auto';
      chatInput.style.height = Math.min(chatInput.scrollHeight, 120) + 'px';
    });
    document.getElementById('send-btn').addEventListener('click', sendMessage);

    async function sendMessage() {
      const text = chatInput.value.trim();
      if (!text) return;

      chatInput.value = '';
      chatInput.style.height = 'auto';
      (document.getElementById('send-btn')).disabled = true;
      document.getElementById('quick-replies').innerHTML = '';

      addMessage('user', text);
      conversationHistory.push({ role: 'user', content: text });

      addTyping();

      try {
        const systemPrompt = selectedMode === 'rate' ? getRateSystemPrompt() : getEquitySystemPrompt();

        const response = await fetch('https://api.anthropic.com/v1/messages', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'x-api-key': apiKey,
            'anthropic-version': '2023-06-01',
            'anthropic-dangerous-direct-browser-access': 'true',
          },
          body: JSON.stringify({
            model: 'claude-sonnet-4-20250514',
            max_tokens: 1500,
            system: systemPrompt,
            messages: conversationHistory,
          }),
        });

        const data = await response.json();
        removeTyping();

        if (data.error) {
          addMessage('ai', `❌ API Error: ${data.error.message}. Please check your API key.`);
          (document.getElementById('send-btn')).disabled = false;
          return;
        }

        const aiText = data.content[0].text;
        conversationHistory.push({ role: 'assistant', content: aiText });

        if (aiText.includes('GENERATE_BRIEF')) {
          const jsonStart = aiText.indexOf('{');
          const jsonEnd = aiText.lastIndexOf('}') + 1;
          const jsonStr = aiText.substring(jsonStart, jsonEnd);
          try {
            const brief = JSON.parse(jsonStr);
            addMessage('ai', '✅ I have everything I need. Your negotiation brief is ready below!');
            setTimeout(() => renderBrief(brief), 500);
          } catch (e) {
            addMessage('ai', aiText.replace('GENERATE_BRIEF', '').trim());
          }
        } else {
          addMessage('ai', aiText);
        }
      } catch (err) {
        removeTyping();
        addMessage('ai', '❌ Connection error. Please check your API key and try again.');
      }

      (document.getElementById('send-btn')).disabled = false;
    }

    function renderBrief(brief) {
      const panel = document.getElementById('result-panel');
      const body = document.getElementById('result-body');
      const title = selectedMode === 'rate' ? 'Rate Negotiation Brief' : 'Equity Negotiation Brief';
      document.getElementById('result-title').textContent = title;

      const argsHtml = (brief.key_arguments || []).map((a) => `
        <div class="result-arg">
          <strong>${a.title}</strong>
          ${a.argument}<br>
          <span style="font-style:italic;color:var(--blue);font-size:12px;margin-top:6px;display:block;">💬 How to say it: "${a.how_to_say}"</span>
        </div>`).join('');

      const objHtml = (brief.handle_objections || []).map((o) => `
        <div class="result-arg" style="border-color:var(--amber);">
          <strong>If they say: "${o.objection}"</strong>
          ${o.response}
        </div>`).join('');

      body.innerHTML = `
        <div class="result-highlight">📋 ${brief.summary || ''}</div>
        <div class="result-section">
          <div class="result-section-title">Opening Position</div>
          <div class="result-arg" style="border-color:var(--green);">${brief.opening_position || ''}</div>
        </div>
        <div class="result-section">
          <div class="result-section-title">Your Key Arguments (${(brief.key_arguments || []).length})</div>
          ${argsHtml}
        </div>
        <div class="result-section">
          <div class="result-section-title">Handling Objections</div>
          ${objHtml}
        </div>
        <div class="result-section">
          <div class="result-section-title">Your Bottom Line</div>
          <div class="result-arg" style="border-color:var(--red);">${brief.bottom_line || ''}</div>
        </div>
        <div class="result-section">
          <div class="result-section-title">Closing Statement</div>
          <div class="result-arg" style="border-color:var(--blue);background:var(--bluebg);">💬 "${brief.closing_line || ''}"</div>
        </div>
        <div class="result-actions">
          <button class="result-btn primary" id="print-brief-btn">⬇ Print / Save PDF</button>
          <button class="result-btn secondary" id="copy-brief-btn">📋 Copy to clipboard</button>
          <button class="result-btn secondary" id="restart-btn">↺ Start over</button>
        </div>
        <div class="result-disclaimer">
          ⚠️ This brief is AI-generated based on information you provided. It is for preparation purposes only and does not constitute legal or financial advice. Always use your own judgment in negotiations.
          <br><br>Generated with <strong>RateKit Deal Coach</strong> · <a href="https://ratekit.org" style="color:var(--blue);">ratekit.org</a>
        </div>
      `;

      document.getElementById('print-brief-btn').addEventListener('click', () => window.print());
      document.getElementById('copy-brief-btn').addEventListener('click', copyBrief);
      document.getElementById('restart-btn').addEventListener('click', () => location.reload());

      panel.style.display = 'block';
      panel.scrollIntoView({ behavior: 'smooth' });
    }

    function copyBrief() {
      const text = (document.getElementById('result-body')).innerText;
      navigator.clipboard.writeText(text).then(() => alert('Brief copied to clipboard!'));
    }
  </script>
</ToolLayout>

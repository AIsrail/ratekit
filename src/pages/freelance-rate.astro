---
import ToolLayout from '../layouts/ToolLayout.astro';

const faq = [
  { q: 'What is a good hourly rate for a freelancer?',
    a: 'It depends on your market and skill, but your floor is the break-even rate from this calculator: target income plus expenses and taxes, divided by realistic billable hours. Price above that floor based on the value you deliver.' },
  { q: 'How many billable hours does a freelancer have per year?',
    a: 'Typically 1,000-1,400. A 40-hour week over 46 weeks is 1,840 hours, but only 50-70% of that is usually billable.' },
  { q: 'Should I charge hourly or per project?',
    a: 'Use the hourly rate as your internal floor, then quote per project or per day where you can. Clients compare outcomes, and fixed prices reward you for working efficiently.' },
];

const related = [
  { label: 'Salary ↔ Hourly Calculator', path: '/salary-hourly' },
  { label: 'Self-Employment Tax Calculator', path: '/self-employment-tax' },
  { label: 'Invoice Generator', path: '/invoice-generator' },
  { label: 'Profit Margin Calculator', path: '/profit-margin' },
];
---
<ToolLayout
  slug="freelance-rate"
  lang="en"
  title="Freelance Rate Calculator"
  description="Calculate your minimum freelance hourly rate based on income goals, expenses, tax rate, and working schedule. Free, instant, no signup."
  pageTag="💰 Free Tool"
  pageTagColor="var(--blue)"
  h1="Freelance Rate Calculator"
  pageSub="Enter your income goals and schedule — get the minimum rate you should charge per hour, day, and project."
  dateModified="2026-10-13"
  guideTitle="How to calculate your freelance hourly rate"
  faq={faq}
  related={related}
>
  <div class="grid-2">
    <div class="panel">
      <div class="panel-title">Income & Expenses</div>
      <div class="panel-title" style="border:none;padding:0;margin-bottom:10px;font-size:11px;">Currency</div>
      <div class="cur-row">
        <button class="cur-btn active" data-sym="$">$ USD</button>
        <button class="cur-btn" data-sym="€">€ EUR</button>
        <button class="cur-btn" data-sym="£">£ GBP</button>
        <button class="cur-btn" data-sym="A$">A$ AUD</button>
      </div>
      <div class="field">
        <label class="lbl">Annual Take-home Income <span class="hint">(after tax goal)</span></label>
        <div class="input-wrap"><span class="ifix" id="sym">$</span><input type="number" id="income" value="60000" min="0"></div>
      </div>
      <div class="field">
        <label class="lbl">Annual Business Expenses <span class="hint">(tools, subscriptions...)</span></label>
        <div class="input-wrap"><span class="ifix" id="sym2">$</span><input type="number" id="expenses" value="5000" min="0"></div>
      </div>
      <div class="field">
        <label class="lbl">Tax Rate</label>
        <div class="input-wrap"><input type="number" id="tax" value="25" min="0" max="99"><span class="ifix ifix-r">%</span></div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-title">Working Schedule</div>
      <div class="field"><label class="lbl">Billable Hours per Day</label><div class="input-wrap"><input type="number" id="hours" value="6" min="1" max="16"><span class="ifix ifix-r">hrs</span></div></div>
      <div class="field"><label class="lbl">Working Days per Week</label><div class="input-wrap"><input type="number" id="days" value="5" min="1" max="7"><span class="ifix ifix-r">days</span></div></div>
      <div class="field"><label class="lbl">Vacation Weeks per Year</label><div class="input-wrap"><input type="number" id="vacation" value="4" min="0" max="30"><span class="ifix ifix-r">wks</span></div></div>
      <div class="field"><label class="lbl">Non-billable Time <span class="hint">(admin, marketing...)</span></label><div class="input-wrap"><input type="number" id="overhead" value="20" min="0" max="80"><span class="ifix ifix-r">%</span></div></div>
    </div>
  </div>

  <div class="results-row" style="grid-template-columns:repeat(3,1fr);">
    <div class="r-card primary"><div class="r-label">Hourly Rate</div><div class="r-value" id="r-hourly">—</div><div class="r-sub">minimum to charge</div></div>
    <div class="r-card"><div class="r-label">Daily Rate</div><div class="r-value" id="r-daily">—</div><div class="r-sub" id="r-daily-sub">per working day</div></div>
    <div class="r-card"><div class="r-label">Monthly Target</div><div class="r-value" id="r-monthly">—</div><div class="r-sub">gross revenue needed</div></div>
  </div>

  <div class="panel">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:40px;">
      <div>
        <div class="panel-title">Annual Revenue Breakdown</div>
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;"><span style="font-size:12px;color:var(--mid);width:130px;flex-shrink:0;">Take-home income</span><div style="flex:1;height:4px;background:var(--bg);border-radius:99px;overflow:hidden;"><div id="bar-income" style="height:100%;border-radius:99px;background:#2563EB;width:0%;transition:width .5s ease;"></div></div><span id="lbl-income" style="font-family:var(--mono);font-size:12px;font-weight:600;width:80px;text-align:right;flex-shrink:0;">—</span></div>
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px;"><span style="font-size:12px;color:var(--mid);width:130px;flex-shrink:0;">Taxes</span><div style="flex:1;height:4px;background:var(--bg);border-radius:99px;overflow:hidden;"><div id="bar-tax" style="height:100%;border-radius:99px;background:#DC2626;width:0%;transition:width .5s ease;"></div></div><span id="lbl-tax" style="font-family:var(--mono);font-size:12px;font-weight:600;width:80px;text-align:right;flex-shrink:0;">—</span></div>
        <div style="display:flex;align-items:center;gap:12px;"><span style="font-size:12px;color:var(--mid);width:130px;flex-shrink:0;">Business expenses</span><div style="flex:1;height:4px;background:var(--bg);border-radius:99px;overflow:hidden;"><div id="bar-exp" style="height:100%;border-radius:99px;background:#94A3B8;width:0%;transition:width .5s ease;"></div></div><span id="lbl-exp" style="font-family:var(--mono);font-size:12px;font-weight:600;width:80px;text-align:right;flex-shrink:0;">—</span></div>
      </div>
      <div>
        <div class="panel-title">Project Estimates</div>
        <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);"><span style="font-size:13px;color:var(--mid);">1-week project</span><span id="est-1w" style="font-family:var(--mono);font-size:15px;font-weight:600;">—</span></div>
        <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);"><span style="font-size:13px;color:var(--mid);">2-week project</span><span id="est-2w" style="font-family:var(--mono);font-size:15px;font-weight:600;">—</span></div>
        <div style="display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);"><span style="font-size:13px;color:var(--mid);">1-month project</span><span id="est-1m" style="font-family:var(--mono);font-size:15px;font-weight:600;">—</span></div>
        <div style="display:flex;justify-content:space-between;padding:10px 0;"><span style="font-size:13px;color:var(--mid);">3-month project</span><span id="est-3m" style="font-family:var(--mono);font-size:15px;font-weight:600;">—</span></div>
      </div>
    </div>
  </div>

  <div class="info-box" id="tip"></div>

  <div class="panel">
    <div class="panel-title">📇 Your Shareable Rate Card</div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;">
      <div class="field"><label class="lbl">Your Name (optional)</label><div class="input-wrap"><input type="text" id="card-name" placeholder="Jane Smith"></div></div>
      <div class="field"><label class="lbl">Specialty / Role</label><div class="input-wrap"><input type="text" id="card-role" placeholder="UX Designer"></div></div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px;">
      <div class="field"><label class="lbl">Country</label><div class="input-wrap"><input type="text" id="card-country" placeholder="United States"></div></div>
      <div class="field"><label class="lbl">Years of Experience</label><div class="input-wrap"><input type="number" id="card-years" placeholder="5" min="0"></div></div>
    </div>
    <div style="background:var(--ink);border-radius:12px;padding:28px;margin-bottom:16px;position:relative;overflow:hidden;">
      <div style="position:absolute;top:0;right:0;width:200px;height:200px;background:radial-gradient(circle,rgba(37,99,235,0.3),transparent 70%);pointer-events:none;"></div>
      <div style="font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.35);margin-bottom:16px;">FREELANCE RATE CARD · 2026</div>
      <div style="font-size:clamp(1.8rem,4vw,2.8rem);font-family:var(--mono);font-weight:700;color:white;line-height:1;" id="card-rate-display">$—/hr</div>
      <div style="font-size:13px;color:rgba(255,255,255,.5);margin-top:6px;margin-bottom:20px;" id="card-daily-display">— /day</div>
      <div style="display:flex;gap:20px;flex-wrap:wrap;">
        <div><div style="font-size:10px;color:rgba(255,255,255,.35);letter-spacing:.1em;text-transform:uppercase;">Name</div><div style="font-size:14px;font-weight:600;color:white;" id="card-name-display">—</div></div>
        <div><div style="font-size:10px;color:rgba(255,255,255,.35);letter-spacing:.1em;text-transform:uppercase;">Specialty</div><div style="font-size:14px;font-weight:600;color:white;" id="card-role-display">—</div></div>
        <div><div style="font-size:10px;color:rgba(255,255,255,.35);letter-spacing:.1em;text-transform:uppercase;">Location</div><div style="font-size:14px;font-weight:600;color:white;" id="card-country-display">—</div></div>
        <div><div style="font-size:10px;color:rgba(255,255,255,.35);letter-spacing:.1em;text-transform:uppercase;">Experience</div><div style="font-size:14px;font-weight:600;color:white;" id="card-years-display">—</div></div>
      </div>
      <div style="margin-top:20px;padding-top:16px;border-top:1px solid rgba(255,255,255,.1);font-size:10px;color:rgba(255,255,255,.2);">Calculated with RateKit · ratekit.org</div>
    </div>
    <div style="display:flex;gap:10px;flex-wrap:wrap;">
      <button id="li-share-btn" style="padding:10px 18px;background:#0077B5;color:white;border:none;border-radius:8px;font-family:var(--font);font-size:13px;font-weight:600;cursor:pointer;">in Share on LinkedIn</button>
      <button id="copy-card-btn" style="padding:10px 18px;background:var(--white);color:var(--mid);border:1.5px solid var(--border);border-radius:8px;font-family:var(--font);font-size:13px;font-weight:600;cursor:pointer;">🔗 Copy link</button>
      <a href="/deal-coach" style="padding:10px 18px;background:var(--white);color:var(--mid);border:1.5px solid var(--border);border-radius:8px;font-family:var(--font);font-size:13px;font-weight:600;cursor:pointer;text-decoration:none;display:inline-block;">🤖 Negotiate this rate →</a>
    </div>
  </div>

  <div class="panel">
    <div class="panel-title">🎯 "What If" Scenario Planner</div>
    <p style="font-size:13px;color:var(--muted);margin-bottom:20px;">See how much more you earn by raising your rate — and how many clients you can afford to lose.</p>
    <div style="margin-bottom:16px;">
      <label class="lbl">Custom increase: <span id="scenario-pct-label" style="color:var(--blue);font-weight:700;">+20%</span></label>
      <input type="range" id="scenario-slider" min="5" max="100" step="5" value="20" style="width:100%;margin-top:8px;accent-color:var(--blue);">
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;" id="scenario-grid"></div>
  </div>

  <Fragment slot="guide">
    <p>Your minimum freelance rate is what you must bill per hour to cover your target income, business expenses and taxes, given the hours you can actually bill. Most freelancers bill only 50-70% of their working time; the rest goes to sales, admin and learning.</p>
    <h3>Formula</h3>
    <pre>Hourly rate = (Target income + Annual expenses) / (1 - Tax rate) / Billable hours per year
Billable hours = Working weeks x Hours per week x Billable %</pre>
    <h3>Example</h3>
    <p>Target income $60,000, expenses $6,000, taxes ~25%. 46 working weeks x 40 h x 60% billable = 1,104 billable hours. ($60,000 + $6,000) / 0.75 / 1,104 = about $80 per hour minimum.</p>
  </Fragment>

  <script>
    let sym = '$';
    let currentHourly = 0;
    let currentDaily = 0;

    document.querySelectorAll('.cur-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        sym = btn.getAttribute('data-sym') || '$';
        document.querySelectorAll('.cur-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById('sym').textContent = sym;
        document.getElementById('sym2').textContent = sym;
        calc();
      });
    });

    function fmt(n) { return sym + Math.round(n).toLocaleString('en-US'); }

    function calc() {
      const income = +document.getElementById('income').value || 0;
      const expenses = +document.getElementById('expenses').value || 0;
      const tax = +document.getElementById('tax').value || 0;
      const hrs = +document.getElementById('hours').value || 1;
      const days = +document.getElementById('days').value || 5;
      const vac = +document.getElementById('vacation').value || 0;
      const oh = +document.getElementById('overhead').value || 0;
      const workWeeks = 52 - vac;
      const workDays = workWeeks * days;
      const billable = workDays * hrs * (1 - oh / 100);
      const gross = (income + expenses) / (1 - tax / 100);
      const hourly = billable > 0 ? gross / billable : 0;
      const daily = hourly * hrs;
      const monthly = gross / 12;

      document.getElementById('r-hourly').textContent = fmt(hourly);
      document.getElementById('r-daily').textContent = fmt(daily);
      document.getElementById('r-daily-sub').textContent = `${hrs}h billable day`;
      document.getElementById('r-monthly').textContent = fmt(monthly);

      const taxes = Math.max(0, gross - income - expenses);
      document.getElementById('lbl-income').textContent = fmt(income);
      document.getElementById('lbl-tax').textContent = fmt(taxes);
      document.getElementById('lbl-exp').textContent = fmt(expenses);
      const t = gross || 1;
      document.getElementById('bar-income').style.width = (income / t * 100) + '%';
      document.getElementById('bar-tax').style.width = (taxes / t * 100) + '%';
      document.getElementById('bar-exp').style.width = (expenses / t * 100) + '%';

      document.getElementById('est-1w').textContent = fmt(daily * days);
      document.getElementById('est-2w').textContent = fmt(daily * days * 2);
      document.getElementById('est-1m').textContent = fmt(daily * days * (workWeeks / 12));
      document.getElementById('est-3m').textContent = fmt(daily * days * (workWeeks / 4));

      const tip = document.getElementById('tip');
      if (hourly < 15) { tip.innerHTML = '<strong>⚠️ Low rate:</strong> Your calculated rate is very low. Consider reducing non-billable time, cutting expenses, or adjusting your income target.'; }
      else if (hourly > 250) { tip.innerHTML = '<strong>🎯 Senior territory:</strong> Rates above $250/hr are achievable for specialized skills (AI, legal, finance, strategy). Ensure your portfolio justifies it.'; }
      else { tip.innerHTML = '<strong>💡 Pro tip:</strong> Add <strong>20–30%</strong> on top of this minimum for your actual quote — this is your break-even rate. Experienced freelancers often charge 2–3× their minimum.'; }

      currentHourly = hourly; currentDaily = daily;
      renderCard();
      renderScenarios(+document.getElementById('scenario-slider').value);
    }

    function renderCard() {
      const name = document.getElementById('card-name').value || 'Your Name';
      const role = document.getElementById('card-role').value || 'Freelancer';
      const country = document.getElementById('card-country').value || '—';
      const years = document.getElementById('card-years').value;
      document.getElementById('card-name-display').textContent = name;
      document.getElementById('card-role-display').textContent = role;
      document.getElementById('card-country-display').textContent = country;
      document.getElementById('card-years-display').textContent = years ? years + ' yrs' : '—';
      document.getElementById('card-rate-display').textContent = currentHourly > 0 ? sym + Math.round(currentHourly) + '/hr' : sym + '—/hr';
      document.getElementById('card-daily-display').textContent = currentDaily > 0 ? sym + Math.round(currentDaily) + '/day' : '— /day';
    }

    document.getElementById('li-share-btn').addEventListener('click', () => {
      const rate = currentHourly > 0 ? sym + Math.round(currentHourly) + '/hr' : 'my rate';
      const role = document.getElementById('card-role').value || 'freelancer';
      const text = encodeURIComponent('Just calculated my minimum freelance rate as a ' + role + ': ' + rate + '. Used this free tool to figure out what I actually need to charge to hit my income goals. ratekit.org/freelance-rate');
      window.open('https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent('https://ratekit.org/freelance-rate') + '&summary=' + text, '_blank');
    });

    document.getElementById('copy-card-btn').addEventListener('click', (e) => {
      const btn = e.currentTarget;
      navigator.clipboard.writeText(window.location.href).then(() => {
        btn.textContent = '✅ Copied!';
        setTimeout(() => btn.textContent = '🔗 Copy link', 2000);
      });
    });

    document.getElementById('scenario-slider').addEventListener('input', () => {
      const pct = +document.getElementById('scenario-slider').value;
      document.getElementById('scenario-pct-label').textContent = '+' + pct + '%';
      renderScenarios(pct);
    });

    function renderScenarios(customPct) {
      if (currentHourly <= 0) return;
      const scenarios = [
        { label: 'Current Rate', mult: 1, color: 'var(--border)', textColor: 'var(--ink)' },
        { label: '+20%', mult: 1.2, color: '#BFDBFE', textColor: 'var(--blue)' },
        { label: '+' + (customPct || 20) + '%', mult: 1 + (customPct || 20) / 100, color: '#6EE7B7', textColor: 'var(--green)' },
      ];

      const income = +document.getElementById('income').value || 0;
      const expenses = +document.getElementById('expenses').value || 0;
      const tax = +document.getElementById('tax').value || 0;
      const hrs = +document.getElementById('hours').value || 6;
      const days = +document.getElementById('days').value || 5;
      const vac = +document.getElementById('vacation').value || 0;
      const workWeeks = 52 - vac;
      const grossNeeded = (income + expenses) / (1 - tax / 100);

      const grid = document.getElementById('scenario-grid');
      grid.innerHTML = scenarios.map((s) => {
        const rate = currentHourly * s.mult;
        const daily = rate * hrs;
        const annualGross = rate * (workWeeks * days * hrs);
        const annualNet = annualGross * (1 - tax / 100) - expenses;
        return '<div style="background:var(--white);border:1.5px solid ' + s.color + ';border-radius:12px;padding:18px;text-align:center;">' +
          '<div style="font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:8px;">' + s.label + '</div>' +
          '<div style="font-family:var(--mono);font-size:1.5rem;font-weight:700;color:' + s.textColor + ';">' + sym + Math.round(rate) + '/hr</div>' +
          '<div style="font-size:11px;color:var(--muted);margin-top:4px;">' + sym + Math.round(daily) + '/day</div>' +
          '<div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border);font-size:11px;color:var(--mid);">Annual gross: <strong>' + sym + Math.round(annualGross / 1000) + 'K</strong></div>' +
          '<div style="font-size:11px;color:var(--mid);">Take-home: <strong>' + sym + Math.round(Math.max(0, annualNet) / 1000) + 'K</strong></div>' +
          '</div>';
      }).join('');
    }

    document.addEventListener('input', calc);
    document.addEventListener('rk:restored', calc);
    window.addEventListener('load', calc);
  </script>
</ToolLayout>

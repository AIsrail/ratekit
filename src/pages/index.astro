---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { tools } from '../data/tools';
import '../styles/base.css';

const title = 'RateKit — Free Business Calculators for Founders & Freelancers';
const description = 'Free business calculators: freelance rate, SAFE equity, burn rate, LTV:CAC, break-even, Stripe fees, VAT, ROI. Built for founders, startups and freelancers.';

const ldGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'RateKit',
      url: 'https://ratekit.org',
      description,
      potentialAction: { '@type': 'SearchAction', target: 'https://ratekit.org/?q={search_term_string}', 'query-input': 'required name=search_term_string' },
    },
    {
      '@type': 'Organization',
      name: 'RateKit',
      alternateName: 'RateKit Business Calculators',
      url: 'https://ratekit.org',
      logo: 'https://ratekit.org/favicon-512x512.png',
      description: 'RateKit.org provides free, no-signup, browser-based business calculators (ROI, break-even, burn rate, freelance rate, VAT, business taxes and more) for founders, startups and freelancers.',
      email: 'connect4fund@gmail.com',
      founder: { '@type': 'Person', name: 'Azat Israilov', url: 'https://azatisrail.org' },
    },
    {
      '@type': 'ItemList',
      name: 'RateKit business calculators',
      itemListElement: tools.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: t.en.label,
        url: `https://ratekit.org${t.en.path}`,
      })),
    },
  ],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/favicon-180x180.png">
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png">
<link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">

<meta property="og:type" content="website">
<meta property="og:url" content="https://ratekit.org/">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content="https://ratekit.org/og-image.png">
<meta property="og:site_name" content="RateKit — Business Calculators">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content="https://ratekit.org/og-image.png">
<link rel="canonical" href="https://ratekit.org/">
<link rel="alternate" hreflang="en" href="https://ratekit.org/">
<link rel="alternate" hreflang="ru" href="https://ratekit.org/ru">
<link rel="alternate" hreflang="x-default" href="https://ratekit.org/">

<script type="application/ld+json" set:html={JSON.stringify(ldGraph)} />

<script async src="https://www.googletagmanager.com/gtag/js?id=G-JZZPXY8N1E"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-JZZPXY8N1E');
</script>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7303101907130018" crossorigin="anonymous"></script>
<meta name="robots" content="index, follow, max-image-preview:large">
<meta property="og:locale" content="en_US">

<style>
.hero{position:relative;padding:96px 48px 72px;text-align:center;background:var(--white);border-bottom:1px solid var(--border-soft);overflow:hidden;}
.hero::before{content:'';position:absolute;top:-220px;left:50%;transform:translateX(-50%);width:900px;height:620px;background:radial-gradient(ellipse at center,rgba(55,86,249,.10),rgba(123,92,250,.07) 45%,transparent 72%);pointer-events:none;}
.hero-inner{position:relative;max-width:720px;margin:0 auto;}
.hero-tag{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--blue);background:var(--bluebg);padding:7px 16px;border-radius:99px;margin-bottom:28px;border:1px solid rgba(55,86,249,.12);}
h1{font-size:clamp(2.1rem,5.2vw,3.7rem);font-weight:800;letter-spacing:-.035em;line-height:1.08;color:var(--ink);margin-bottom:20px;}
h1 em{font-style:normal;background:linear-gradient(135deg,var(--blue),var(--violet));-webkit-background-clip:text;background-clip:text;color:transparent;}
.hero-sub{font-size:18px;color:var(--mid);font-weight:400;max-width:540px;margin:0 auto 36px;}
.hero-badges{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;}
.hbadge{font-size:12.5px;font-weight:600;color:var(--mid);display:flex;align-items:center;gap:6px;background:var(--bg);border:1px solid var(--border);padding:7px 14px;border-radius:99px;}
.hbadge .dot{width:14px;height:14px;border-radius:50%;background:var(--greenbg);color:var(--green);display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:800;}

.tools-section{padding:72px 48px 88px;max-width:1280px;margin:0 auto;}
.section-label{font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:28px;}
.tools-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:22px;}
.tool-card{position:relative;overflow:hidden;background:var(--white);border:1px solid var(--border);border-radius:var(--radius-lg);padding:34px;transition:border-color .2s var(--ease),box-shadow .25s var(--ease),transform .25s var(--ease);display:flex;flex-direction:column;box-shadow:var(--shadow-sm);animation:rk-card-in .5s var(--ease) backwards;}
.tool-card::after{content:'';position:absolute;inset:0;background:linear-gradient(115deg,transparent 40%,rgba(255,255,255,.55) 50%,transparent 60%);transform:translateX(-120%);transition:transform .7s var(--ease);pointer-events:none;}
.tool-card:hover{border-color:transparent;box-shadow:var(--shadow-lg);transform:translateY(-6px);}
.tool-card:hover::after{transform:translateX(120%);}
@keyframes rk-card-in{from{opacity:0;transform:translateY(14px);}to{opacity:1;transform:translateY(0);}}
@media(prefers-reduced-motion:reduce){.tool-card{animation:none;}}
.card-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:22px;}
.card-icon{width:56px;height:56px;border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:25px;transition:transform .35s var(--ease);box-shadow:inset 0 1px 0 rgba(255,255,255,.6),var(--shadow-xs);}
.tool-card:hover .card-icon{transform:scale(1.12) rotate(-6deg);}
.card-icon.blue{background:linear-gradient(145deg,#EEF1FE,#DCE3FD);} .card-icon.violet{background:linear-gradient(145deg,#F4F1FE,#E7E0FC);} .card-icon.green{background:linear-gradient(145deg,#ECFDF6,#D4F5E6);} .card-icon.amber{background:linear-gradient(145deg,#FFFBEB,#FDF0C8);} .card-icon.red{background:linear-gradient(145deg,#FEF2F2,#FCE0E0);}
.card-title{font-size:20px;font-weight:800;color:var(--ink);margin-bottom:11px;letter-spacing:-.02em;line-height:1.25;}
.card-desc{font-size:14.5px;color:var(--mid);line-height:1.7;flex:1;margin-bottom:24px;}
.card-tags{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:24px;}
.tag{font-size:11.5px;font-weight:600;padding:4px 10px;border-radius:7px;background:var(--bg);color:var(--mid);border:1px solid var(--border);}
.card-link{display:inline-flex;align-items:center;gap:6px;font-size:14px;font-weight:700;color:var(--blue);transition:gap .18s var(--ease);}
.tool-card:hover .card-link{gap:10px;}
.popular-badge{font-size:10.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--amber);background:var(--amberbg);padding:5px 10px;border-radius:99px;border:1px solid #FDE68A;white-space:nowrap;}

.suggest-card{border:2px dashed rgba(123,92,250,.35);background:linear-gradient(175deg,var(--violetbg),var(--white) 65%);}
.suggest-card:hover{border-color:rgba(123,92,250,.55);}
.suggest-lead{font-size:14.5px;color:var(--mid);line-height:1.7;margin-bottom:18px;}
.idea-input{width:100%;border:1.5px solid var(--border);border-radius:10px;padding:10px 12px;font-family:var(--font);font-size:13px;color:var(--ink);resize:vertical;margin-bottom:12px;background:var(--white);transition:border-color .15s var(--ease);}
.idea-input:focus{outline:none;border-color:var(--violet);}
.idea-btn{align-self:flex-start;background:linear-gradient(135deg,var(--blue),var(--violet));color:#fff;border:none;padding:9px 18px;border-radius:99px;font-family:var(--font);font-size:13px;font-weight:700;cursor:pointer;transition:all .18s var(--ease);}
.idea-btn:hover{filter:brightness(1.07);transform:translateY(-1px);}

.rates-section{padding:0 48px;max-width:1280px;margin:-22px auto 0;position:relative;z-index:2;}
.rates-bar{background:var(--white);border:1px solid var(--border);border-radius:var(--radius-lg);box-shadow:var(--shadow-md);padding:16px 24px;display:flex;align-items:center;gap:22px;flex-wrap:wrap;}
.rates-group{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.rates-label{font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);white-space:nowrap;display:flex;align-items:center;gap:6px;}
.rates-updated{font-size:10px;color:var(--muted);text-transform:none;letter-spacing:0;font-weight:500;}
.rates-divider{width:1px;align-self:stretch;background:var(--border-soft);}
.rates-chips{display:flex;gap:8px;flex-wrap:wrap;}
.rate-chip{display:inline-flex;align-items:center;gap:4px;font-family:var(--mono);font-size:12.5px;font-weight:600;color:var(--ink);background:var(--bg);border:1px solid var(--border);border-radius:99px;padding:5px 12px;}
.rate-chip b{font-family:var(--font);font-weight:700;color:var(--mid);margin-right:2px;}
.rate-chip.up{color:var(--green);}
.rate-chip.down{color:var(--red);}
.rate-chip .chg{font-size:10px;margin-left:1px;}
.rates-skel{width:76px;height:25px;border-radius:99px;background:linear-gradient(90deg,var(--bg) 25%,var(--border-soft) 37%,var(--bg) 63%);background-size:400% 100%;animation:rk-shimmer 1.4s ease infinite;}
@keyframes rk-shimmer{0%{background-position:100% 50%}100%{background-position:0 50%}}
@media(max-width:768px){.hero{padding:56px 20px 44px;}.tools-section{padding:40px 20px 56px;}.rates-section{padding:0 20px;}.rates-bar{padding:14px 16px;gap:14px;}}
</style>
</head>
<body>
<Nav lang="en" altLangPath="/ru" />

<div class="hero">
  <div class="hero-inner">
    <div class="hero-tag">✦ Free · No signup · Instant results</div>
    <h1>Business calculators for<br><em>founders & freelancers</em></h1>
    <p class="hero-sub">Make smarter financial decisions with tools built for startups, consultants, and independent professionals.</p>
    <div class="hero-badges">
      <span class="hbadge"><span class="dot">✓</span>100% free forever</span>
      <span class="hbadge"><span class="dot">✓</span>No data stored</span>
      <span class="hbadge"><span class="dot">✓</span>Works on mobile</span>
      <span class="hbadge"><span class="dot">✓</span>Instant calculations</span>
    </div>
  </div>
</div>

<section class="rates-section">
  <div class="rates-bar" id="rates-bar">
    <div class="rates-group">
      <span class="rates-label">💱 Live rates<span class="rates-updated" id="rates-updated"></span></span>
      <div class="rates-chips" id="fx-chips">
        <span class="rates-skel"></span><span class="rates-skel"></span><span class="rates-skel"></span><span class="rates-skel"></span>
      </div>
    </div>
    <div class="rates-divider"></div>
    <div class="rates-group">
      <span class="rates-label">₿ Crypto</span>
      <div class="rates-chips" id="crypto-chips">
        <span class="rates-skel"></span><span class="rates-skel"></span><span class="rates-skel"></span>
      </div>
    </div>
  </div>
</section>

<section class="tools-section">
  <div class="section-label">All tools — {tools.length} tools</div>
  <div class="tools-grid">
    {tools.map((t, i) => (
      <a href={t.en.path} class="tool-card" style={`animation-delay:${Math.min(i * 40, 400)}ms`}>
        <div class="card-header">
          <div class={`card-icon ${t.accent}`}>{t.icon}</div>
          {t.en.badge && <span class="popular-badge">{t.en.badge}</span>}
        </div>
        <div class="card-title">{t.en.cardTitle}</div>
        <p class="card-desc">{t.en.desc}</p>
        <div class="card-tags">{t.en.tags?.map((tag) => <span class="tag">{tag}</span>)}</div>
        <span class="card-link">Open calculator →</span>
      </a>
    ))}
    <div class="tool-card suggest-card" style={`animation-delay:${Math.min(tools.length * 40, 400)}ms`}>
      <div class="card-header">
        <div class="card-icon violet">💡</div>
      </div>
      <div class="card-title">Got an idea for a calculator?</div>
      <p class="suggest-lead">Tell us what tool you wish existed — we read every suggestion and build the good ones.</p>
      <textarea id="idea-input" class="idea-input" rows="2" placeholder="e.g. a calculator for…"></textarea>
      <button class="idea-btn" id="idea-btn" type="button">Send idea →</button>
    </div>
  </div>
</section>

<Footer lang="en" />

<script>
  var ideaBtn = document.getElementById('idea-btn');
  ideaBtn && ideaBtn.addEventListener('click', function () {
    var input = document.getElementById('idea-input');
    var text = input && input.value.trim();
    if (!text) { input && input.focus(); return; }
    var subject = encodeURIComponent('RateKit tool idea');
    var body = encodeURIComponent(text + '\n\n— sent from ratekit.org');
    window.location.href = 'mailto:connect4fund@gmail.com?subject=' + subject + '&body=' + body;
  });
</script>

<script>
  (function () {
    var fxChips = document.getElementById('fx-chips');
    var cryptoChips = document.getElementById('crypto-chips');
    var updatedEl = document.getElementById('rates-updated');
    if (!fxChips) return;

    function fmt(n) {
      if (n >= 1000) return n.toLocaleString('en-US', { maximumFractionDigits: 0 });
      if (n >= 1) return n.toLocaleString('en-US', { maximumFractionDigits: 2 });
      return n.toLocaleString('en-US', { maximumFractionDigits: 4 });
    }

    function render(data) {
      fxChips.innerHTML = data.fiat.map(function (r) {
        return '<span class="rate-chip"><b>' + r.code + '</b>' + fmt(r.value) + ' ' + data.localCurrency + '</span>';
      }).join('');
      cryptoChips.innerHTML = data.crypto.map(function (c) {
        var dir = c.change24h == null ? '' : (c.change24h >= 0 ? 'up' : 'down');
        var arrow = c.change24h == null ? '' : (c.change24h >= 0 ? '▲' : '▼');
        var chg = c.change24h == null ? '' : (' <span class="chg">' + arrow + Math.abs(c.change24h).toFixed(1) + '%</span>');
        return '<span class="rate-chip ' + dir + '"><b>' + c.symbol + '</b>$' + fmt(c.usd) + chg + '</span>';
      }).join('');
      updatedEl.textContent = '· updated just now';
    }

    function load() {
      fetch('/api/rates').then(function (r) {
        if (!r.ok) throw new Error('bad response');
        return r.json();
      }).then(render).catch(function () {
        var bar = document.getElementById('rates-bar');
        if (bar) bar.style.display = 'none';
      });
    }

    load();
    setInterval(load, 5 * 60 * 1000);
  })();
</script>
</body>
</html>

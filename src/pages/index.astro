---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { tools } from '../data/tools';
import '../styles/base.css';

const title = 'RateKit — Free Business Calculators for Founders & Freelancers';
const description = 'Free business calculators: freelance rate, SAFE equity, burn rate, LTV:CAC, break-even, Stripe fees, VAT, ROI. Built for founders, startups and freelancers.';

const ldGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'RateKit',
      url: 'https://ratekit.org',
      description,
      potentialAction: { '@type': 'SearchAction', target: 'https://ratekit.org/?q={search_term_string}', 'query-input': 'required name=search_term_string' },
    },
    {
      '@type': 'Organization',
      name: 'RateKit',
      alternateName: 'RateKit Business Calculators',
      url: 'https://ratekit.org',
      logo: 'https://ratekit.org/favicon-512x512.png',
      description: 'RateKit.org provides free, no-signup, browser-based business calculators (ROI, break-even, burn rate, freelance rate, VAT, business taxes and more) for founders, startups and freelancers.',
      email: 'connect4fund@gmail.com',
      founder: { '@type': 'Person', name: 'Azat Israilov', url: 'https://azatisrail.org' },
    },
    {
      '@type': 'ItemList',
      name: 'RateKit business calculators',
      itemListElement: tools.map((t, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: t.en.label,
        url: `https://ratekit.org${t.en.path}`,
      })),
    },
  ],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/favicon-180x180.png">
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png">
<link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">

<meta property="og:type" content="website">
<meta property="og:url" content="https://ratekit.org/">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content="https://ratekit.org/og-image.png">
<meta property="og:site_name" content="RateKit — Business Calculators">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content="https://ratekit.org/og-image.png">
<link rel="canonical" href="https://ratekit.org/">
<link rel="alternate" hreflang="en" href="https://ratekit.org/">
<link rel="alternate" hreflang="ru" href="https://ratekit.org/ru">
<link rel="alternate" hreflang="x-default" href="https://ratekit.org/">

<script type="application/ld+json" set:html={JSON.stringify(ldGraph)} />

<script async src="https://www.googletagmanager.com/gtag/js?id=G-JZZPXY8N1E"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-JZZPXY8N1E');
</script>
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7303101907130018" crossorigin="anonymous"></script>
<meta name="robots" content="index, follow, max-image-preview:large">
<meta property="og:locale" content="en_US">

<style>
.hero{position:relative;padding:96px 48px 72px;text-align:center;background:var(--white);border-bottom:1px solid var(--border-soft);overflow:hidden;}
.hero::before{content:'';position:absolute;top:-220px;left:50%;transform:translateX(-50%);width:900px;height:620px;background:radial-gradient(ellipse at center,rgba(55,86,249,.10),rgba(123,92,250,.07) 45%,transparent 72%);pointer-events:none;}
.hero-inner{position:relative;max-width:720px;margin:0 auto;}
.hero-tag{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--blue);background:var(--bluebg);padding:7px 16px;border-radius:99px;margin-bottom:28px;border:1px solid rgba(55,86,249,.12);}
h1{font-size:clamp(2.1rem,5.2vw,3.7rem);font-weight:800;letter-spacing:-.035em;line-height:1.08;color:var(--ink);margin-bottom:20px;}
h1 em{font-style:normal;background:linear-gradient(135deg,var(--blue),var(--violet));-webkit-background-clip:text;background-clip:text;color:transparent;}
.hero-sub{font-size:18px;color:var(--mid);font-weight:400;max-width:540px;margin:0 auto 36px;}
.hero-badges{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;}
.hbadge{font-size:12.5px;font-weight:600;color:var(--mid);display:flex;align-items:center;gap:6px;background:var(--bg);border:1px solid var(--border);padding:7px 14px;border-radius:99px;}
.hbadge .dot{width:14px;height:14px;border-radius:50%;background:var(--greenbg);color:var(--green);display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:800;}

.tools-section{padding:72px 48px 88px;max-width:1280px;margin:0 auto;}
.section-label{font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:28px;}
.tools-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:18px;}
.tool-card{position:relative;background:var(--white);border:1px solid var(--border);border-radius:var(--radius-lg);padding:28px;transition:border-color .2s var(--ease),box-shadow .25s var(--ease),transform .25s var(--ease);display:flex;flex-direction:column;box-shadow:var(--shadow-xs);}
.tool-card:hover{border-color:transparent;box-shadow:var(--shadow-lg);transform:translateY(-3px);}
.card-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:18px;}
.card-icon{width:46px;height:46px;border-radius:13px;display:flex;align-items:center;justify-content:center;font-size:21px;}
.card-icon.blue{background:var(--bluebg);} .card-icon.violet{background:var(--violetbg);} .card-icon.green{background:var(--greenbg);} .card-icon.amber{background:var(--amberbg);} .card-icon.red{background:var(--redbg);}
.card-title{font-size:17px;font-weight:700;color:var(--ink);margin-bottom:8px;letter-spacing:-.01em;}
.card-desc{font-size:14px;color:var(--mid);line-height:1.65;flex:1;margin-bottom:20px;}
.card-tags{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:20px;}
.tag{font-size:11px;font-weight:500;padding:3px 9px;border-radius:6px;background:var(--bg);color:var(--mid);border:1px solid var(--border);}
.card-link{display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:var(--blue);transition:gap .18s var(--ease);}
.tool-card:hover .card-link{gap:10px;}
.popular-badge{font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--amber);background:var(--amberbg);padding:4px 9px;border-radius:99px;border:1px solid #FDE68A;white-space:nowrap;}

@media(max-width:768px){.hero{padding:56px 20px 44px;}.tools-section{padding:40px 20px 56px;}}
</style>
</head>
<body>
<Nav lang="en" altLangPath="/ru" />

<div class="hero">
  <div class="hero-inner">
    <div class="hero-tag">✦ Free · No signup · Instant results</div>
    <h1>Business calculators for<br><em>founders & freelancers</em></h1>
    <p class="hero-sub">Make smarter financial decisions with tools built for startups, consultants, and independent professionals.</p>
    <div class="hero-badges">
      <span class="hbadge"><span class="dot">✓</span>100% free forever</span>
      <span class="hbadge"><span class="dot">✓</span>No data stored</span>
      <span class="hbadge"><span class="dot">✓</span>Works on mobile</span>
      <span class="hbadge"><span class="dot">✓</span>Instant calculations</span>
    </div>
  </div>
</div>

<section class="tools-section">
  <div class="section-label">All tools — {tools.length} tools</div>
  <div class="tools-grid">
    {tools.map((t) => (
      <a href={t.en.path} class="tool-card">
        <div class="card-header">
          <div class={`card-icon ${t.accent}`}>{t.icon}</div>
          {t.en.badge && <span class="popular-badge">{t.en.badge}</span>}
        </div>
        <div class="card-title">{t.en.cardTitle}</div>
        <p class="card-desc">{t.en.desc}</p>
        <div class="card-tags">{t.en.tags?.map((tag) => <span class="tag">{tag}</span>)}</div>
        <span class="card-link">Open calculator →</span>
      </a>
    ))}
  </div>
</section>

<Footer lang="en" />
</body>
</html>
